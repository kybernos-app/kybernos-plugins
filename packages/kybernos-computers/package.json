{
  "name": "@local/kybernos-computers",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Cloud computers for agents: the E2B backend (bring your own key), a Settings page for the key, a composer menu to choose where code runs, and agent tools to start, use, freeze and stop a sandbox.",
  "license": "Apache-2.0",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "check": "node --check index.js && node --check client.js",
    "test": "node test-computers-host.mjs"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.18.4",
    "@e2b/sdk": "^2.5.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-api-remotes"
      ]
    }
  }
}
