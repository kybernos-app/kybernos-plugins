{
  "contract": 1,
  "id": "kybernos/terminal",
  "kind": "code",
  "version": "0.1.0",
  "name": {
    "en": "Terminal",
    "fr": "Terminal"
  },
  "description": {
    "en": "Command blocks in the chat as terminal windows, with a button to run them.",
    "fr": "Les blocs de commandes du chat en fenêtres de terminal, avec un bouton pour les lancer."
  },
  "icon": "term",
  "family": "create",
  "author": {
    "id": "kybernos",
    "name": "Kybernos"
  },
  "license": "Apache-2.0",
  "pricing": "free",
  "package": "@local/kybernos-terminal",
  "entry": {
    "host": "index.js",
    "client": "client/client.js"
  },
  "requires": {
    "kybernos": ">=0.1.0"
  },
  "permissions": [
    "ui.dom",
    "host.routes:/kybernos-terminal:write",
    "fs.read:workspace",
    "fs.write:workspace",
    "exec"
  ],
  "claims": {
    "routePrefixes": [
      "/kybernos-terminal"
    ]
  },
  "help": "help.json",
  "suite": {
    "default": "off"
  }
}
