{
  "contract": 1,
  "id": "kybernos/miniapps",
  "kind": "code",
  "version": "0.1.0",
  "name": {
    "en": "Mini-apps",
    "fr": "Mini-apps"
  },
  "description": {
    "en": "\"Install as app\": a panel becomes a native app.",
    "fr": "« Install as app » : un panneau devient une app native."
  },
  "icon": "app",
  "family": "create",
  "author": {
    "id": "kybernos",
    "name": "Kybernos"
  },
  "license": "Apache-2.0",
  "pricing": "free",
  "package": "@local/kybernos-miniapps",
  "entry": {
    "host": "index.js",
    "client": "client.js"
  },
  "requires": {
    "kybernos": ">=0.1.0"
  },
  "permissions": [
    "ui.dom",
    "host.routes:/kybernos-miniapps:write",
    "fs.write:home",
    "exec:codesign",
    "exec:launchctl",
    "exec:open",
    "exec:pkill",
    "exec:plutil"
  ],
  "claims": {
    "routePrefixes": [
      "/kybernos-miniapps"
    ]
  },
  "help": "help.json",
  "suite": {
    "default": "on"
  }
}
