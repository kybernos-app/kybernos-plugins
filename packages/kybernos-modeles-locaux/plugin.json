{
  "contract": 1,
  "id": "kybernos/modeles-locaux",
  "kind": "code",
  "version": "1.0.0",
  "name": {
    "en": "Ollama local models",
    "fr": "Modèles locaux Ollama"
  },
  "description": {
    "en": "Local models detected and installed from Settings.",
    "fr": "Modèles locaux détectés et installés depuis les Réglages."
  },
  "icon": "home",
