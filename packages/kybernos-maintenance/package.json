{
  "name": "@local/kybernos-maintenance",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Page Réglages « Maintenance · Kybernos » : indicateur vert/orange, versions moteur+plugin, journal des mises à jour (quoi, de → vers, résultat). Lecture seule.",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-theme"
      ]
    }
  }
}