{
  "contract": 1,
  "id": "kybernos/search",
  "kind": "code",
  "version": "0.1.0",
  "name": {
    "en": "Search everywhere",
    "fr": "Recherche partout"
  },
  "description": {
    "en": "Searches the content of your chats, skills, memories, lessons and creations.",
    "fr": "Cherche dans le contenu des chats, des skills, des mémoires, des leçons et des créations."
  },
  "icon": "lens",
  "family": "base",
  "author": {
    "id": "kybernos",
    "name": "Kybernos"
  },
  "license": "Apache-2.0",
  "pricing": "free",
  "package": "@local/kybernos-search",
  "entry": {
    "host": "index.js",
    "client": "client.js"
  },
  "requires": {
    "kybernos": ">=0.1.0"
  },
  "permissions": [
    "ui.dom",
    "host.routes:/kybernos-search:write",
    "fs.read:dsh-home",
    "fs.write:dsh-home",
    "memory.read",
    "sessions.read"
  ],
  "claims": {
    "routePrefixes": [
      "/kybernos-search"
    ]
  },
  "help": "help.json",
  "suite": {
    "default": "on"
  }
}
