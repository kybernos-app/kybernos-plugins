{
  "id": "overview",
  "name": "Shop overview",
  "desc": "Revenue from paid orders, what is waiting to ship, the products running low and where your orders come from.",
  "menu": {
    "en": "Overview",
    "fr": "Vue d’ensemble"
  },
  "overview": true,
  "widgets": [
    {
      "type": "card",
      "title": "Revenue, paid orders",
      "source": {
        "provider": "db.rows",
        "params": {
          "db": "ecommerce",
          "object": "orders"
        }
      },
      "metric": {
        "agg": "sum",
        "field": "value",
        "where": [
          {
            "field": "stage_key",
            "op": "in",
            "value": [
              "paid",
              "packed",
              "shipped",
              "delivered"
            ]
          }
        ]
      },
      "w": 3,
      "h": 2,
      "unit": "€",
      "sub": {
        "template": "{v} orders paid",
        "metric": {
          "agg": "count",
          "where": [
            {
              "field": "stage_key",
              "op": "in",
              "value": [
                "paid",
                "packed",
                "shipped",
                "delivered"
              ]
            }
          ]
        }
      }
    },
    {
      "type": "card",
      "title": "Orders to ship",
      "source": {
        "provider": "db.rows",
        "params": {
          "db": "ecommerce",
          "object": "orders"
        }
      },
      "metric": {
        "agg": "count",
        "where": [
          {
            "field": "stage_key",
            "op": "in",
            "value": [
              "paid",
              "packed"
            ]
          }
        ]
      },
      "w": 3,
      "h": 2,
      "sub": {
        "template": "{v} not paid yet",
        "metric": {
          "agg": "count",
          "where": [
            {
              "field": "stage_key",
              "op": "=",
              "value": "new"
            }
          ]
        }
      }
    },
    {
      "type": "card",
      "title": "Low stock",
      "source": {
        "provider": "db.rows",
        "params": {
          "db": "ecommerce",
          "object": "product",
          "diff": "stock,reorder_at"
        }
      },
      "metric": {
        "agg": "count",
        "where": [
          {
            "field": "stock_minus_reorder_at",
            "op": "not_empty"
          },
          {
            "field": "stock_minus_reorder_at",
            "op": "<=",
            "value": 0
          },
          {
            "field": "status_key",
            "op": "not_in",
            "value": [
              "draft"
            ]
          }
        ]
      },
      "w": 3,
      "h": 2,
      "sub": {
        "template": "{v} out of stock",
        "metric": {
          "agg": "count",
          "where": [
            {
              "field": "status_key",
              "op": "=",
              "value": "out"
            }
          ]
        }
      }
    },
    {
      "type": "card",
      "title": "Customers",
      "source": {
        "provider": "db.rows",
        "params": {
          "db": "ecommerce",
          "object": "contact"
        }
      },
      "metric": {
        "agg": "count",
        "where": [
          {
            "field": "type_key",
            "op": "=",
            "value": "customer"
          }
        ]
      },
      "w": 3,
      "h": 2,
      "sub": {
        "template": "{v} repeat buyers",
        "metric": {
          "agg": "count",
          "where": [
            {
              "field": "type_key",
              "op": "=",
              "value": "customer"
            },
            {
              "field": "tags_key",
              "op": "contains",
              "value": "repeat"
            }
          ]
        }
      }
    },
    {
      "type": "chart",
      "title": "Orders by status",
      "kind": "columns",
      "x": "stage",
      "agg": "count",
      "source": {
        "provider": "db.rows",
        "params": {
          "db": "ecommerce",
          "object": "orders",
          "order": "stage"
        }
      },
      "w": 8,
      "h": 4
    },
    {
      "type": "chart",
      "title": "Products by category",
      "kind": "donut",
      "x": "category",
      "agg": "count",
      "limit": 6,
      "source": {
        "provider": "db.rows",
        "params": {
          "db": "ecommerce",
          "object": "product"
        }
      },
      "w": 4,
      "h": 4
    },
    {
      "type": "list",
      "title": "Next orders to ship",
      "label": "title",
      "sub": "summary",
      "when": "due",
      "where": [
        {
          "field": "stage_key",
          "op": "in",
          "value": [
            "paid",
            "packed"
          ]
        }
      ],
      "sort": "due",
      "limit": 6,
      "source": {
        "provider": "db.rows",
        "params": {
          "db": "ecommerce",
          "object": "orders"
        }
      },
      "w": 6,
      "h": 5
    },
    {
      "type": "table",
      "title": "Stock to reorder",
      "columns": [
        {
          "field": "title",
          "label": "Product"
        },
        {
          "field": "stock",
          "label": "In stock",
          "format": "number"
        },
        {
          "field": "reorder_at",
          "label": "Reorder at",
          "format": "number"
        },
        {
          "field": "supplier",
          "label": "Supplier"
        }
      ],
      "where": [
        {
          "field": "stock_minus_reorder_at",
          "op": "not_empty"
        },
        {
          "field": "stock_minus_reorder_at",
          "op": "<=",
          "value": 0
        },
        {
          "field": "status_key",
          "op": "not_in",
          "value": [
            "draft"
          ]
        }
      ],
      "sort": "stock_minus_reorder_at",
      "limit": 6,
      "source": {
        "provider": "db.rows",
        "params": {
          "db": "ecommerce",
          "object": "product",
          "diff": "stock,reorder_at"
        }
      },
      "w": 6,
      "h": 5
    },
    {
      "type": "chart",
      "title": "Top products by orders",
      "kind": "bars",
      "x": "product",
      "agg": "count",
      "limit": 7,
      "source": {
        "provider": "db.rows",
        "params": {
          "db": "ecommerce",
          "object": "orders"
        }
      },
      "w": 6,
      "h": 4
    },
    {
      "type": "chart",
      "title": "Orders by source",
      "kind": "bars",
      "x": "source",
      "agg": "count",
      "limit": 6,
      "source": {
        "provider": "db.rows",
        "params": {
          "db": "ecommerce",
          "object": "orders"
        }
      },
      "w": 6,
      "h": 4
    }
  ]
}
