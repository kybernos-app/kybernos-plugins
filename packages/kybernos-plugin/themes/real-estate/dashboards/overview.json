{
  "id": "overview",
  "name": "Agency overview",
  "desc": "The listings on the books, the sales in progress, the viewings to run and the mandates that are about to end.",
  "menu": {
    "en": "Overview",
    "fr": "Vue d’ensemble"
  },
  "overview": true,
  "widgets": [
    {
      "type": "card",
      "title": "Active listings",
      "source": {
        "provider": "db.rows",
        "params": {
          "db": "real-estate",
          "object": "property"
        }
      },
      "metric": {
        "agg": "count",
        "where": [
          {
            "field": "status_key",
            "op": "in",
            "value": [
              "for-sale",
              "to-let",
              "under-offer"
            ]
          }
        ]
      },
      "w": 3,
      "h": 2,
      "sub": {
        "template": "{v} under offer",
        "metric": {
          "agg": "count",
          "where": [
            {
              "field": "status_key",
              "op": "=",
              "value": "under-offer"
            }
          ]
        }
      }
    },
    {
      "type": "card",
      "title": "Open sales value",
      "source": {
        "provider": "db.rows",
        "params": {
          "db": "real-estate",
          "object": "sales"
        }
      },
      "metric": {
        "agg": "sum",
        "field": "value",
        "where": [
          {
            "field": "stage_key",
            "op": "not_in",
            "value": [
              "closed"
            ]
          }
        ]
      },
      "w": 3,
      "h": 2,
      "format": "compact",
      "unit": "€",
      "sub": {
        "template": "{v} sales in progress",
        "metric": {
          "agg": "count",
          "where": [
            {
              "field": "stage_key",
              "op": "not_in",
              "value": [
                "closed"
              ]
            }
          ]
        }
      }
    },
    {
      "type": "card",
      "title": "Sales viewings to run",
      "source": {
        "provider": "db.rows",
        "params": {
          "db": "real-estate",
          "object": "sales"
        }
      },
      "metric": {
        "agg": "count",
        "where": [
          {
            "field": "stage_key",
            "op": "=",
            "value": "viewing"
          }
        ]
      },
      "w": 3,
      "h": 2,
      "sub": {
        "template": "{v} due within a week",
        "metric": {
          "agg": "count",
          "where": [
            {
              "field": "stage_key",
              "op": "=",
              "value": "viewing"
            },
            {
              "field": "due",
              "op": "not_empty"
            },
            {
              "field": "due_in",
              "op": ">=",
              "value": 0
            },
            {
              "field": "due_in",
              "op": "<=",
              "value": 7
            }
          ]
        }
      }
    },
    {
      "type": "card",
      "title": "Mandates ending soon",
      "source": {
        "provider": "db.rows",
        "params": {
          "db": "real-estate",
          "object": "property"
        }
      },
      "metric": {
        "agg": "count",
        "where": [
          {
            "field": "mandate_until",
            "op": "not_empty"
          },
          {
            "field": "status_key",
            "op": "not_in",
            "value": [
              "sold"
            ]
          },
          {
            "field": "mandate_until_in",
            "op": "<=",
            "value": 120
          }
        ]
      },
      "w": 3,
      "h": 2,
      "sub": {
        "template": "{v} properties with a mandate on file",
        "metric": {
          "agg": "count",
          "where": [
            {
              "field": "mandate_until",
              "op": "not_empty"
            },
            {
              "field": "status_key",
              "op": "not_in",
              "value": [
                "sold"
              ]
            }
          ]
        }
      }
    },
    {
      "type": "chart",
      "title": "Properties by status",
      "kind": "donut",
      "x": "status",
      "agg": "count",
      "source": {
        "provider": "db.rows",
        "params": {
          "db": "real-estate",
          "object": "property"
        }
      },
      "w": 4,
      "h": 4
    },
    {
      "type": "chart",
      "title": "Sales pipeline by stage",
      "kind": "columns",
      "x": "stage",
      "y": "value",
      "agg": "sum",
      "unit": "€",
      "source": {
        "provider": "db.rows",
        "params": {
          "db": "real-estate",
          "object": "sales",
          "order": "stage"
        }
      },
      "w": 8,
      "h": 4
    },
    {
      "type": "chart",
      "title": "Sales leads by source",
      "kind": "bars",
      "x": "source",
      "agg": "count",
      "limit": 6,
      "source": {
        "provider": "db.rows",
        "params": {
          "db": "real-estate",
          "object": "sales"
        }
      },
      "w": 4,
      "h": 5,
      "where": []
    },
    {
      "type": "list",
      "title": "Mandates ending soon, by date",
      "label": "title",
      "sub": "address",
      "when": "mandate_until",
      "where": [
        {
          "field": "mandate_until",
          "op": "not_empty"
        },
        {
          "field": "status_key",
          "op": "not_in",
          "value": [
            "sold"
          ]
        },
        {
          "field": "mandate_until_in",
          "op": "<=",
          "value": 120
        }
      ],
      "sort": "mandate_until",
      "limit": 6,
      "source": {
        "provider": "db.rows",
        "params": {
          "db": "real-estate",
          "object": "property"
        }
      },
      "w": 4,
      "h": 5
    },
    {
      "type": "list",
      "title": "Next sales viewings and follow-ups",
      "label": "title",
      "sub": "summary",
      "when": "due",
      "where": [
        {
          "field": "stage_key",
          "op": "in",
          "value": [
            "enquiry",
            "viewing"
          ]
        },
        {
          "field": "due",
          "op": "not_empty"
        }
      ],
      "sort": "due",
      "limit": 6,
      "source": {
        "provider": "db.rows",
        "params": {
          "db": "real-estate",
          "object": "sales"
        }
      },
      "w": 4,
      "h": 5
    }
  ]
}
