{
  "contract": 1,
  "id": "kybernos/registry",
  "kind": "code",
  "version": "0.1.0",
  "name": {
    "en": "Plugin registry",
    "fr": "Registre des plugins"
  },
  "description": {
    "en": "Reads the plugins other people made, checks that they are plain data, and lets the pages use what they add.",
    "fr": "Lit les plugins faits par d’autres, vérifie que ce sont des données simples et laisse les pages utiliser ce qu’ils ajoutent."
  },
  "icon": "puzzle",
  "family": "base",
  "author": {
    "id": "kybernos",
    "name": "Kybernos"
  },
  "license": "Apache-2.0",
  "pricing": "free",
  "package": "@local/kybernos-registry",
  "entry": {
    "host": "index.js",
    "client": "client.js"
  },
  "requires": {
    "kybernos": ">=0.1.0"
  },
  "permissions": [
    "host.routes:/kybernos-registry:write",
    "fs.read:dsh-home",
    "fs.write:dsh-home"
  ],
  "claims": {
    "routePrefixes": [
      "/kybernos-registry"
    ]
  },
  "help": "help.json",
  "suite": {
    "core": true,
    "default": "on"
  }
}
