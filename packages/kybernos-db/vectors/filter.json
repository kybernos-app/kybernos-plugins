{
  "suite": "filter",
  "doc": "Three modes. check: the « path:code » problems of a filter (strict). prepare: the filter as it can be applied now (forgiving). matches (the default): the records, named by the last two characters of their id, that pass the filter, fail-closed, over all eight records of the task fixture (08 is a deleted one: matches does not look at deletion, queryRecords does). Today is 2026-10-30, me is noor.",
  "cases": [
    { "name": "matches: an empty filter lets everything through", "flt": { "conj": "and", "items": [] }, "expect": ["01", "02", "03", "04", "05", "06", "07", "08"] },
    { "name": "matches: a choice is", "flt": { "conj": "and", "items": [{ "k": "status", "op": "is", "v": "todo" }] }, "expect": ["02", "03", "06", "08"] },
    { "name": "matches: a choice is not (a record without status would pass)", "flt": { "conj": "and", "items": [{ "k": "status", "op": "isnot", "v": "done" }] }, "expect": ["01", "02", "03", "05", "06", "08"] },
    { "name": "matches: a choice is any of", "flt": { "conj": "and", "items": [{ "k": "status", "op": "in", "v": ["todo", "doing"] }] }, "expect": ["01", "02", "03", "05", "06", "08"] },
    { "name": "matches: a choice is none of", "flt": { "conj": "and", "items": [{ "k": "status", "op": "nin", "v": ["done"] }] }, "expect": ["01", "02", "03", "05", "06", "08"] },
    { "name": "matches: a choice is empty", "flt": { "conj": "and", "items": [{ "k": "status", "op": "empty" }] }, "expect": [] },
    { "name": "matches: a person is me", "flt": { "conj": "and", "items": [{ "k": "assignee", "op": "is", "v": "@me" }] }, "expect": ["01", "03", "06", "07"] },
    { "name": "matches: a person is not me (nobody counts)", "flt": { "conj": "and", "items": [{ "k": "assignee", "op": "isnot", "v": "@me" }] }, "expect": ["02", "04", "05", "08"] },
    { "name": "matches: a person is any of me and another", "flt": { "conj": "and", "items": [{ "k": "assignee", "op": "in", "v": ["@me", "ines"] }] }, "expect": ["01", "02", "03", "04", "06", "07", "08"] },
    { "name": "matches: @me with nobody signed in matches nothing", "ctx": { "me": null }, "flt": { "conj": "and", "items": [{ "k": "assignee", "op": "is", "v": "@me" }] }, "expect": [] },
    { "name": "matches: a person is empty", "flt": { "conj": "and", "items": [{ "k": "assignee", "op": "empty" }] }, "expect": ["05"] },
    { "name": "matches: text contains ignores case and accents", "flt": { "conj": "and", "items": [{ "k": "title", "op": "contains", "v": "ECRAN" }] }, "expect": ["07"] },
    { "name": "matches: text contains finds an accent from a plain letter", "flt": { "conj": "and", "items": [{ "k": "title", "op": "contains", "v": "eclair" }] }, "expect": ["05"] },
    { "name": "matches: text does not contain", "flt": { "conj": "and", "items": [{ "k": "title", "op": "ncontains", "v": "post" }] }, "expect": ["02", "03", "04", "05", "06", "07", "08"] },
    { "name": "matches: text is (whole value, folded)", "flt": { "conj": "and", "items": [{ "k": "title", "op": "is", "v": "call SUPPLIER" }] }, "expect": ["06"] },
    { "name": "matches: text is not", "flt": { "conj": "and", "items": [{ "k": "title", "op": "isnot", "v": "call supplier" }] }, "expect": ["01", "02", "03", "04", "05", "07", "08"] },
    { "name": "matches: an email contains", "flt": { "conj": "and", "items": [{ "k": "contact", "op": "contains", "v": "@example" }] }, "expect": ["02"] },
    { "name": "matches: a phone contains", "flt": { "conj": "and", "items": [{ "k": "phone", "op": "contains", "v": "67 89" }] }, "expect": ["06"] },
    { "name": "matches: a number greater than", "flt": { "conj": "and", "items": [{ "k": "estimate", "op": "gt", "v": 2 }] }, "expect": ["01", "04", "07"] },
    { "name": "matches: a number at least", "flt": { "conj": "and", "items": [{ "k": "estimate", "op": "ge", "v": 2 }] }, "expect": ["01", "03", "04", "07"] },
    { "name": "matches: a number less than", "flt": { "conj": "and", "items": [{ "k": "estimate", "op": "lt", "v": 2 }] }, "expect": ["02", "06"] },
    { "name": "matches: a number at most", "flt": { "conj": "and", "items": [{ "k": "estimate", "op": "le", "v": 1.5 }] }, "expect": ["02", "06"] },
    { "name": "matches: a number equals", "flt": { "conj": "and", "items": [{ "k": "estimate", "op": "eq", "v": 3 }] }, "expect": ["01"] },
    { "name": "matches: a number differs (an empty one differs)", "flt": { "conj": "and", "items": [{ "k": "estimate", "op": "ne", "v": 3 }] }, "expect": ["02", "03", "04", "05", "06", "07", "08"] },
    { "name": "matches: a number is empty", "flt": { "conj": "and", "items": [{ "k": "estimate", "op": "empty" }] }, "expect": ["05", "08"] },
    { "name": "matches: money equals zero (empty is not zero)", "flt": { "conj": "and", "items": [{ "k": "budget", "op": "eq", "v": 0 }] }, "expect": ["02"] },
    { "name": "matches: money is empty", "flt": { "conj": "and", "items": [{ "k": "budget", "op": "empty" }] }, "expect": ["03", "06", "08"] },
    { "name": "matches: a checkbox is checked", "flt": { "conj": "and", "items": [{ "k": "urgent", "op": "checked" }] }, "expect": ["01", "02"] },
    { "name": "matches: a checkbox is unchecked", "flt": { "conj": "and", "items": [{ "k": "urgent", "op": "unchecked" }] }, "expect": ["03", "04", "05", "06", "07", "08"] },
    { "name": "matches: tags has any of", "flt": { "conj": "and", "items": [{ "k": "tags", "op": "in", "v": ["bug"] }] }, "expect": ["02", "05"] },
    { "name": "matches: tags has any of two", "flt": { "conj": "and", "items": [{ "k": "tags", "op": "in", "v": ["ui", "api"] }] }, "expect": ["01", "02", "04", "05", "07"] },
    { "name": "matches: tags has none of (an empty one has none)", "flt": { "conj": "and", "items": [{ "k": "tags", "op": "nin", "v": ["bug"] }] }, "expect": ["01", "03", "04", "06", "07", "08"] },
    { "name": "matches: tags has all of", "flt": { "conj": "and", "items": [{ "k": "tags", "op": "all", "v": ["ui", "bug"] }] }, "expect": ["05"] },
    { "name": "matches: tags is empty", "flt": { "conj": "and", "items": [{ "k": "tags", "op": "empty" }] }, "expect": ["03", "06", "08"] },
    { "name": "matches: a date is today", "flt": { "conj": "and", "items": [{ "k": "due", "op": "is", "v": { "n": 0 } }] }, "expect": ["02"] },
    { "name": "matches: a date is a given day", "flt": { "conj": "and", "items": [{ "k": "due", "op": "is", "v": { "d": "2026-10-31" } }] }, "expect": ["01"] },
    { "name": "matches: a date is before today", "flt": { "conj": "and", "items": [{ "k": "due", "op": "before", "v": { "n": 0 } }] }, "expect": ["04", "06", "08"] },
    { "name": "matches: a date is after today", "flt": { "conj": "and", "items": [{ "k": "due", "op": "after", "v": { "n": 0 } }] }, "expect": ["01", "03", "07"] },
    { "name": "matches: a date is before a given day", "flt": { "conj": "and", "items": [{ "k": "due", "op": "before", "v": { "d": "2026-10-28" } }] }, "expect": ["04", "06", "08"] },
    { "name": "matches: a date is within the next 7 days (both ends count)", "flt": { "conj": "and", "items": [{ "k": "due", "op": "within", "v": "next7" }] }, "expect": ["01", "02"] },
    { "name": "matches: a date is within the next 30 days (day 30 counts)", "flt": { "conj": "and", "items": [{ "k": "due", "op": "within", "v": "next30" }] }, "expect": ["01", "02", "03", "07"] },
    { "name": "matches: a date is within the past 7 days", "flt": { "conj": "and", "items": [{ "k": "due", "op": "within", "v": "past7" }] }, "expect": ["02", "06"] },
    { "name": "matches: a date is within the past 30 days", "flt": { "conj": "and", "items": [{ "k": "due", "op": "within", "v": "past30" }] }, "expect": ["02", "04", "06", "08"] },
    { "name": "matches: a date is empty", "flt": { "conj": "and", "items": [{ "k": "due", "op": "empty" }] }, "expect": ["05"] },
    { "name": "matches: today comes from the caller", "ctx": { "today": "2026-11-12" }, "flt": { "conj": "and", "items": [{ "k": "due", "op": "is", "v": { "n": 0 } }] }, "expect": ["03"] },
    { "name": "matches: a relative date without today throws, whatever the rows hold", "ctx": { "today": null }, "flt": { "conj": "and", "items": [{ "k": "due", "op": "before", "v": { "n": 0 } }] }, "expect": { "throws": "TypeError" } },
    { "name": "matches: an exact date needs no today", "ctx": { "today": null }, "flt": { "conj": "and", "items": [{ "k": "due", "op": "before", "v": { "d": "2026-10-28" } }] }, "expect": ["04", "06", "08"] },
    { "name": "matches: a relation has any of", "flt": { "conj": "and", "items": [{ "k": "project", "op": "in", "v": ["#P1"] }] }, "expect": ["01", "03"] },
    { "name": "matches: a to-one relation is", "flt": { "conj": "and", "items": [{ "k": "project", "op": "is", "v": "#P2" }] }, "expect": ["02", "04"] },
    { "name": "matches: a relation has none of", "flt": { "conj": "and", "items": [{ "k": "project", "op": "nin", "v": ["#P1"] }] }, "expect": ["02", "04", "05", "06", "07", "08"] },
    { "name": "matches: a relation is empty", "flt": { "conj": "and", "items": [{ "k": "project", "op": "empty" }] }, "expect": ["05", "06", "07", "08"] },
    { "name": "matches: a to-many relation has any of", "flt": { "conj": "and", "items": [{ "k": "depends", "op": "in", "v": ["#T01"] }] }, "expect": ["02", "03"] },
    { "name": "matches: a to-many relation has all of", "flt": { "conj": "and", "items": [{ "k": "depends", "op": "all", "v": ["#T01", "#T02"] }] }, "expect": ["03"] },
    { "name": "matches: a to-many relation has none of", "flt": { "conj": "and", "items": [{ "k": "depends", "op": "nin", "v": ["#T01"] }] }, "expect": ["01", "04", "05", "06", "07", "08"] },
    { "name": "matches: files are not empty", "flt": { "conj": "and", "items": [{ "k": "files", "op": "nempty" }] }, "expect": ["01"] },
    { "name": "matches: files are empty", "flt": { "conj": "and", "items": [{ "k": "files", "op": "empty" }] }, "expect": ["02", "03", "04", "05", "06", "07", "08"] },
    { "name": "matches: and across a group of or", "flt": { "conj": "and", "items": [{ "k": "status", "op": "is", "v": "todo" }, { "conj": "or", "items": [{ "k": "assignee", "op": "is", "v": "@me" }, { "k": "due", "op": "before", "v": { "n": 0 } }] }] }, "expect": ["03", "06", "08"] },
    { "name": "matches: or at the top", "flt": { "conj": "or", "items": [{ "k": "urgent", "op": "checked" }, { "k": "status", "op": "is", "v": "done" }] }, "expect": ["01", "02", "04", "07"] },
    { "name": "matches: an empty group is ignored by its parent", "flt": { "conj": "and", "items": [{ "k": "status", "op": "is", "v": "done" }, { "conj": "or", "items": [] }] }, "expect": ["04", "07"] },
    { "name": "matches: an incomplete condition fails closed", "flt": { "conj": "and", "items": [{ "k": "title", "op": "contains", "v": "" }] }, "expect": [] },
    { "name": "matches: a condition on an unknown field fails closed", "flt": { "conj": "and", "items": [{ "k": "nope", "op": "is", "v": "x" }] }, "expect": [] },
    { "name": "matches: an operator the field does not have fails closed", "flt": { "conj": "and", "items": [{ "k": "estimate", "op": "contains", "v": "3" }] }, "expect": [] },
    { "name": "matches: a failed condition does not poison an or", "flt": { "conj": "or", "items": [{ "k": "nope", "op": "is", "v": "x" }, { "k": "status", "op": "is", "v": "done" }] }, "expect": ["04", "07"] },
    { "name": "matches: not a filter at all", "flt": "everything", "expect": [] },

    { "name": "check: a sound filter has no problem", "mode": "check", "flt": { "conj": "and", "items": [{ "k": "status", "op": "in", "v": ["todo"] }, { "conj": "or", "items": [{ "k": "due", "op": "within", "v": "next7" }, { "k": "urgent", "op": "checked" }] }] }, "expect": [] },
    { "name": "check: not an object", "mode": "check", "flt": null, "expect": [":shape"] },
    { "name": "check: conj is and / or", "mode": "check", "flt": { "items": [] }, "expect": [":conj"] },
    { "name": "check: a stray key on a group", "mode": "check", "flt": { "conj": "and", "items": [], "not": true }, "expect": [":unknown-key"] },
    { "name": "check: an unknown field", "mode": "check", "flt": { "conj": "and", "items": [{ "k": "nope", "op": "is", "v": "x" }] }, "expect": ["0:unknown-field"] },
    { "name": "check: an operator the type lacks", "mode": "check", "flt": { "conj": "and", "items": [{ "k": "estimate", "op": "contains", "v": "3" }] }, "expect": ["0:bad-op"] },
    { "name": "check: a missing value", "mode": "check", "flt": { "conj": "and", "items": [{ "k": "title", "op": "contains", "v": "" }] }, "expect": ["0:incomplete"] },
    { "name": "check: an empty list", "mode": "check", "flt": { "conj": "and", "items": [{ "k": "status", "op": "in", "v": [] }] }, "expect": ["0:incomplete"] },
    { "name": "check: a text where a number belongs", "mode": "check", "flt": { "conj": "and", "items": [{ "k": "estimate", "op": "eq", "v": "3" }] }, "expect": ["0:bad-value"] },
    { "name": "check: a fractional number of days", "mode": "check", "flt": { "conj": "and", "items": [{ "k": "due", "op": "is", "v": { "n": 1.5 } }] }, "expect": ["0:bad-value"] },
    { "name": "check: a day that does not exist", "mode": "check", "flt": { "conj": "and", "items": [{ "k": "due", "op": "is", "v": { "d": "2026-02-30" } }] }, "expect": ["0:bad-value"] },
    { "name": "check: an unknown window", "mode": "check", "flt": { "conj": "and", "items": [{ "k": "due", "op": "within", "v": "next9" }] }, "expect": ["0:bad-value"] },
    { "name": "check: empty takes no value", "mode": "check", "flt": { "conj": "and", "items": [{ "k": "status", "op": "empty", "v": "x" }] }, "expect": ["0:bad-value"] },
    { "name": "check: a list where a single key belongs", "mode": "check", "flt": { "conj": "and", "items": [{ "k": "status", "op": "is", "v": ["todo"] }] }, "expect": ["0:bad-value"] },
    { "name": "check: groups go one level deep", "mode": "check", "flt": { "conj": "and", "items": [{ "conj": "or", "items": [{ "conj": "and", "items": [] }] }] }, "expect": ["0.0:depth"] },
    { "name": "check: the path of a problem inside a group", "mode": "check", "flt": { "conj": "and", "items": [{ "k": "status", "op": "is", "v": "todo" }, { "conj": "or", "items": [{ "k": "nope", "op": "empty" }] }] }, "expect": ["1.0:unknown-field"] },
    { "name": "check: a condition with a stray key", "mode": "check", "flt": { "conj": "and", "items": [{ "k": "status", "op": "is", "v": "todo", "not": true }] }, "expect": ["0:shape"] },
    { "name": "check: an item that is not a condition", "mode": "check", "flt": { "conj": "and", "items": [5] }, "expect": ["0:shape"] },
    { "name": "check: at most 50 conditions", "mode": "check", "flt": { "conj": "and", "items": { "$repeat": [{ "k": "status", "op": "empty" }, 51] } }, "expect": ["50:too-many"] },
    { "name": "check: 50 conditions are fine", "mode": "check", "flt": { "conj": "and", "items": { "$repeat": [{ "k": "status", "op": "empty" }, 50] } }, "expect": [] },

    { "name": "prepare: what cannot filter yet is dropped, the rest is kept", "mode": "prepare", "flt": { "conj": "or", "items": [{ "k": "status", "op": "is", "v": "todo" }, { "k": "nope", "op": "is", "v": "x" }, { "k": "title", "op": "contains", "v": "" }, { "conj": "and", "items": [{ "k": "estimate", "op": "gt", "v": "5" }] }, { "k": "tags", "op": "empty", "v": "junk" }, { "k": "due", "op": "empty" }] }, "expect": { "conj": "or", "items": [{ "k": "status", "op": "is", "v": "todo" }, { "k": "due", "op": "empty", "v": null }] } },
    { "name": "prepare: a group that keeps something stays", "mode": "prepare", "flt": { "conj": "and", "items": [{ "conj": "or", "items": [{ "k": "nope", "op": "empty" }, { "k": "urgent", "op": "checked" }] }] }, "expect": { "conj": "and", "items": [{ "conj": "or", "items": [{ "k": "urgent", "op": "checked", "v": null }] }] } },
    { "name": "prepare: a bad conj becomes and", "mode": "prepare", "flt": { "conj": "xor", "items": [{ "k": "urgent", "op": "checked" }] }, "expect": { "conj": "and", "items": [{ "k": "urgent", "op": "checked", "v": null }] } },
    { "name": "prepare: a group inside a group is dropped", "mode": "prepare", "flt": { "conj": "and", "items": [{ "conj": "or", "items": [{ "conj": "and", "items": [{ "k": "urgent", "op": "checked" }] }] }] }, "expect": { "conj": "and", "items": [] } },
    { "name": "prepare: not a filter gives a blank one", "mode": "prepare", "flt": "everything", "expect": { "conj": "and", "items": [] } }
  ]
}
