{
  "suite": "values",
  "doc": "normalizeValue(field, input): the canonical form of a value, or the code of the refusal. Nothing is coerced; an empty value is null (a checkbox is false).",
  "cases": [
    { "name": "text is kept as is", "field": { "type": "text" }, "input": "Hello  world", "expect": { "ok": true, "value": "Hello  world" } },
    { "name": "an empty text is null", "field": { "type": "text" }, "input": "", "expect": { "ok": true, "value": null } },
    { "name": "null stays null", "field": { "type": "text" }, "input": null, "expect": { "ok": true, "value": null } },
    { "name": "a number is not a text", "field": { "type": "text" }, "input": 5, "expect": { "ok": false, "code": "type" } },
    { "name": "text is at most 1000 characters", "field": { "type": "text" }, "input": { "$repeat": ["a", 1001] }, "expect": { "ok": false, "code": "too-long" } },
    { "name": "1000 characters are fine", "field": { "type": "text" }, "input": { "$repeat": ["a", 1000] }, "expect": { "ok": true, "value": { "$repeat": ["a", 1000] } } },
    { "name": "longtext takes 1001 characters", "field": { "type": "longtext" }, "input": { "$repeat": ["a", 1001] }, "expect": { "ok": true, "value": { "$repeat": ["a", 1001] } } },
    { "name": "email", "field": { "type": "email" }, "input": "ines@example.com", "expect": { "ok": true, "value": "ines@example.com" } },
    { "name": "email without an at sign", "field": { "type": "email" }, "input": "ines.example.com", "expect": { "ok": false, "code": "format" } },
    { "name": "email with a space", "field": { "type": "email" }, "input": "in es@example.com", "expect": { "ok": false, "code": "format" } },
    { "name": "url", "field": { "type": "url" }, "input": "https://example.com/a?b=1#c", "expect": { "ok": true, "value": "https://example.com/a?b=1#c" } },
    { "name": "url must be http or https", "field": { "type": "url" }, "input": "ftp://example.com", "expect": { "ok": false, "code": "format" } },
    { "name": "url cannot hold a space", "field": { "type": "url" }, "input": "https://example.com/a b", "expect": { "ok": false, "code": "format" } },
    { "name": "phone", "field": { "type": "phone" }, "input": "+33 1 23 45 67 89", "expect": { "ok": true, "value": "+33 1 23 45 67 89" } },
    { "name": "phone with letters", "field": { "type": "phone" }, "input": "call me", "expect": { "ok": false, "code": "format" } },
    { "name": "number", "field": { "type": "number" }, "input": 12.5, "expect": { "ok": true, "value": 12.5 } },
    { "name": "a text is not a number", "field": { "type": "number" }, "input": "12", "expect": { "ok": false, "code": "type" } },
    { "name": "number range", "field": { "type": "number" }, "input": 1e16, "expect": { "ok": false, "code": "range" } },
    { "name": "money rounds half away from zero (1.005 → 1.01)", "field": { "type": "money", "precision": 2 }, "input": 1.005, "expect": { "ok": true, "value": 1.01 } },
    { "name": "money, negative", "field": { "type": "money", "precision": 2 }, "input": -1.005, "expect": { "ok": true, "value": -1.01 } },
    { "name": "money 12.345", "field": { "type": "money", "precision": 2 }, "input": 12.345, "expect": { "ok": true, "value": 12.35 } },
    { "name": "money without precision defaults to 2", "field": { "type": "money" }, "input": 3.14159, "expect": { "ok": true, "value": 3.14 } },
    { "name": "money, precision 0", "field": { "type": "money", "precision": 0 }, "input": 2.5, "expect": { "ok": true, "value": 3 } },
    { "name": "money, precision 0, negative", "field": { "type": "money", "precision": 0 }, "input": -2.5, "expect": { "ok": true, "value": -3 } },
    { "name": "money, precision 4", "field": { "type": "money", "precision": 4 }, "input": 1.23456, "expect": { "ok": true, "value": 1.2346 } },
    { "name": "money that rounds to zero", "field": { "type": "money", "precision": 2 }, "input": 0.004, "expect": { "ok": true, "value": 0 } },
    { "name": "date", "field": { "type": "date" }, "input": "2024-02-29", "expect": { "ok": true, "value": "2024-02-29" } },
    { "name": "a day that does not exist", "field": { "type": "date" }, "input": "2026-02-30", "expect": { "ok": false, "code": "format" } },
    { "name": "29 February of a common year", "field": { "type": "date" }, "input": "2026-02-29", "expect": { "ok": false, "code": "format" } },
    { "name": "a date needs two digits for the month", "field": { "type": "date" }, "input": "2026-2-3", "expect": { "ok": false, "code": "format" } },
    { "name": "a number is not a date", "field": { "type": "date" }, "input": 20261030, "expect": { "ok": false, "code": "format" } },
    { "name": "a checkbox that was never set is false", "field": { "type": "checkbox" }, "input": null, "expect": { "ok": true, "value": false } },
    { "name": "a checked box", "field": { "type": "checkbox" }, "input": true, "expect": { "ok": true, "value": true } },
    { "name": "yes is not true", "field": { "type": "checkbox" }, "input": "yes", "expect": { "ok": false, "code": "type" } },
    { "name": "choice", "field": { "type": "choice", "options": [{ "key": "todo", "label": "To do" }] }, "input": "todo", "expect": { "ok": true, "value": "todo" } },
    { "name": "choice, not an option", "field": { "type": "choice", "options": [{ "key": "todo", "label": "To do" }] }, "input": "nope", "expect": { "ok": false, "code": "option" } },
    { "name": "choice, a number", "field": { "type": "choice", "options": [{ "key": "todo", "label": "To do" }] }, "input": 1, "expect": { "ok": false, "code": "option" } },
    { "name": "multichoice", "field": { "type": "multichoice", "options": [{ "key": "bug", "label": "Bug" }, { "key": "ui", "label": "UI" }] }, "input": ["ui", "bug"], "expect": { "ok": true, "value": ["ui", "bug"] } },
    { "name": "multichoice drops a repeat and keeps the order", "field": { "type": "multichoice", "options": [{ "key": "bug", "label": "Bug" }, { "key": "ui", "label": "UI" }] }, "input": ["ui", "bug", "ui"], "expect": { "ok": true, "value": ["ui", "bug"] } },
    { "name": "an empty multichoice is null", "field": { "type": "multichoice", "options": [{ "key": "bug", "label": "Bug" }] }, "input": [], "expect": { "ok": true, "value": null } },
    { "name": "multichoice, not an option", "field": { "type": "multichoice", "options": [{ "key": "bug", "label": "Bug" }] }, "input": ["x"], "expect": { "ok": false, "code": "option" } },
    { "name": "multichoice, not a list", "field": { "type": "multichoice", "options": [{ "key": "bug", "label": "Bug" }] }, "input": "bug", "expect": { "ok": false, "code": "type" } },
    { "name": "person", "field": { "type": "person" }, "input": "noor", "expect": { "ok": true, "value": "noor" } },
    { "name": "person, empty text is not an id", "field": { "type": "person" }, "input": "", "expect": { "ok": false, "code": "type" } },
    { "name": "relation to one record", "field": { "type": "relation", "to": "project", "many": false }, "input": "#P1", "expect": { "ok": true, "value": "#P1" } },
    { "name": "relation, not a record id", "field": { "type": "relation", "to": "project", "many": false }, "input": "abc", "expect": { "ok": false, "code": "type" } },
    { "name": "relation, lower-case ULID is refused", "field": { "type": "relation", "to": "project", "many": false }, "input": "01jbprjt000000000000000001", "expect": { "ok": false, "code": "type" } },
    { "name": "relation to many", "field": { "type": "relation", "to": "task", "many": true }, "input": ["#T01", "#T02"], "expect": { "ok": true, "value": ["#T01", "#T02"] } },
    { "name": "relation to many drops a repeat", "field": { "type": "relation", "to": "task", "many": true }, "input": ["#T01", "#T01"], "expect": { "ok": true, "value": ["#T01"] } },
    { "name": "a many relation is a list", "field": { "type": "relation", "to": "task", "many": true }, "input": "#T01", "expect": { "ok": false, "code": "type" } },
    { "name": "attachment", "field": { "type": "attachment" }, "input": [{ "name": "brief.pdf", "size": 120000, "type": "application/pdf", "hash": "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855" }], "expect": { "ok": true, "value": [{ "name": "brief.pdf", "size": 120000, "type": "application/pdf", "hash": "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855" }] } },
    { "name": "an empty attachment is null", "field": { "type": "attachment" }, "input": [], "expect": { "ok": true, "value": null } },
    { "name": "attachment, not a list", "field": { "type": "attachment" }, "input": "brief.pdf", "expect": { "ok": false, "code": "type" } },
    { "name": "attachment, an extra key", "field": { "type": "attachment" }, "input": [{ "name": "a.png", "size": 1, "type": "image/png", "hash": "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855", "path": "/etc" }], "expect": { "ok": false, "code": "shape" } },
    { "name": "attachment, a missing key", "field": { "type": "attachment" }, "input": [{ "name": "a.png", "size": 1, "type": "image/png" }], "expect": { "ok": false, "code": "shape" } },
    { "name": "attachment, a name with a slash", "field": { "type": "attachment" }, "input": [{ "name": "../a.png", "size": 1, "type": "image/png", "hash": "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855" }], "expect": { "ok": false, "code": "format" } },
    { "name": "attachment, a negative size", "field": { "type": "attachment" }, "input": [{ "name": "a.png", "size": -1, "type": "image/png", "hash": "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855" }], "expect": { "ok": false, "code": "format" } },
    { "name": "attachment, a fractional size", "field": { "type": "attachment" }, "input": [{ "name": "a.png", "size": 1.5, "type": "image/png", "hash": "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855" }], "expect": { "ok": false, "code": "format" } },
    { "name": "attachment, a hash in capitals", "field": { "type": "attachment" }, "input": [{ "name": "a.png", "size": 1, "type": "image/png", "hash": "E3B0C44298FC1C149AFBF4C8996FB92427AE41E4649B934CA495991B7852B855" }], "expect": { "ok": false, "code": "format" } },
    { "name": "attachment, not a media type", "field": { "type": "attachment" }, "input": [{ "name": "a.png", "size": 1, "type": "png", "hash": "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855" }], "expect": { "ok": false, "code": "format" } },
    { "name": "attachment over the default cap (25 MB)", "field": { "type": "attachment" }, "input": [{ "name": "big.bin", "size": 26214401, "type": "application/octet-stream", "hash": "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855" }], "expect": { "ok": false, "code": "too-big" } },
    { "name": "attachment exactly at the cap", "field": { "type": "attachment" }, "input": [{ "name": "big.bin", "size": 26214400, "type": "application/octet-stream", "hash": "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855" }], "expect": { "ok": true, "value": [{ "name": "big.bin", "size": 26214400, "type": "application/octet-stream", "hash": "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855" }] } },
    { "name": "attachment over a field's own cap", "field": { "type": "attachment", "maxBytes": 1000 }, "input": [{ "name": "a.png", "size": 1001, "type": "image/png", "hash": "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855" }], "expect": { "ok": false, "code": "too-big" } },
    { "name": "attachment, at most 20 files", "field": { "type": "attachment" }, "input": { "$repeat": [{ "name": "a.png", "size": 1, "type": "image/png", "hash": "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855" }, 21] }, "expect": { "ok": false, "code": "too-many" } },
    { "name": "an unknown field type", "field": { "type": "rollup" }, "input": 1, "expect": { "ok": false, "code": "type" } }
  ]
}
