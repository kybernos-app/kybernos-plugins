{
  "suite": "ops",
  "doc": "Operations. A case with `steps` applies the operations in order to a record (`start`, or none) and lists each answer; a failed step leaves the record as it was. `buildCreate` and `buildUpdate` cases check the operation built from raw values.",
  "cases": [
    {
      "name": "steps: a record's whole life (create, update, delete, a refused update, delete again, restore, restore again)",
      "steps": [
        { "id": "#X1", "kind": "create", "object": "task", "record": "#T09", "set": { "title": "Draft spec", "status": "todo" }, "by": "noor", "at": "2026-10-30T09:00:00.000Z" },
        { "id": "#X2", "kind": "update", "object": "task", "record": "#T09", "set": { "status": "doing", "estimate": 2 }, "prev": { "status": "todo", "estimate": null }, "by": "kaby", "at": "2026-10-30T09:05:00.000Z" },
        { "id": "#X3", "kind": "delete", "object": "task", "record": "#T09", "by": "noor", "at": "2026-10-30T09:10:00.000Z" },
        { "id": "#X4", "kind": "update", "object": "task", "record": "#T09", "set": { "estimate": 5 }, "by": "noor", "at": "2026-10-30T09:11:00.000Z" },
        { "id": "#X5", "kind": "delete", "object": "task", "record": "#T09", "by": "kaby", "at": "2026-10-30T09:12:00.000Z" },
        { "id": "#X6", "kind": "restore", "object": "task", "record": "#T09", "by": "noor", "at": "2026-10-30T09:20:00.000Z" },
        { "id": "#X7", "kind": "restore", "object": "task", "record": "#T09", "by": "kaby", "at": "2026-10-30T09:21:00.000Z" }
      ],
      "expect": [
        { "ok": true, "record": { "id": "#T09", "values": { "title": "Draft spec", "status": "todo", "assignee": null, "due": null, "estimate": null, "budget": null, "urgent": false, "tags": null, "project": null, "depends": null, "files": null, "site": null, "contact": null, "phone": null, "notes": null }, "rev": 1, "created": { "by": "noor", "at": "2026-10-30T09:00:00.000Z" }, "modified": { "by": "noor", "at": "2026-10-30T09:00:00.000Z" }, "deleted": null } },
        { "ok": true, "record": { "id": "#T09", "values": { "title": "Draft spec", "status": "doing", "assignee": null, "due": null, "estimate": 2, "budget": null, "urgent": false, "tags": null, "project": null, "depends": null, "files": null, "site": null, "contact": null, "phone": null, "notes": null }, "rev": 2, "created": { "by": "noor", "at": "2026-10-30T09:00:00.000Z" }, "modified": { "by": "kaby", "at": "2026-10-30T09:05:00.000Z" }, "deleted": null } },
        { "ok": true, "record": { "id": "#T09", "values": { "title": "Draft spec", "status": "doing", "assignee": null, "due": null, "estimate": 2, "budget": null, "urgent": false, "tags": null, "project": null, "depends": null, "files": null, "site": null, "contact": null, "phone": null, "notes": null }, "rev": 3, "created": { "by": "noor", "at": "2026-10-30T09:00:00.000Z" }, "modified": { "by": "noor", "at": "2026-10-30T09:10:00.000Z" }, "deleted": { "by": "noor", "at": "2026-10-30T09:10:00.000Z" } } },
        { "ok": false, "code": "deleted" },
        { "ok": true, "record": { "id": "#T09", "values": { "title": "Draft spec", "status": "doing", "assignee": null, "due": null, "estimate": 2, "budget": null, "urgent": false, "tags": null, "project": null, "depends": null, "files": null, "site": null, "contact": null, "phone": null, "notes": null }, "rev": 3, "created": { "by": "noor", "at": "2026-10-30T09:00:00.000Z" }, "modified": { "by": "noor", "at": "2026-10-30T09:10:00.000Z" }, "deleted": { "by": "noor", "at": "2026-10-30T09:10:00.000Z" } } },
        { "ok": true, "record": { "id": "#T09", "values": { "title": "Draft spec", "status": "doing", "assignee": null, "due": null, "estimate": 2, "budget": null, "urgent": false, "tags": null, "project": null, "depends": null, "files": null, "site": null, "contact": null, "phone": null, "notes": null }, "rev": 4, "created": { "by": "noor", "at": "2026-10-30T09:00:00.000Z" }, "modified": { "by": "noor", "at": "2026-10-30T09:20:00.000Z" }, "deleted": null } },
        { "ok": true, "record": { "id": "#T09", "values": { "title": "Draft spec", "status": "doing", "assignee": null, "due": null, "estimate": 2, "budget": null, "urgent": false, "tags": null, "project": null, "depends": null, "files": null, "site": null, "contact": null, "phone": null, "notes": null }, "rev": 4, "created": { "by": "noor", "at": "2026-10-30T09:00:00.000Z" }, "modified": { "by": "noor", "at": "2026-10-30T09:20:00.000Z" }, "deleted": null } }
      ]
    },
    { "name": "steps: an update before the record exists", "steps": [{ "id": "#X1", "kind": "update", "object": "task", "record": "#T09", "set": { "estimate": 1 }, "by": "noor", "at": "2026-10-30T09:00:00.000Z" }], "expect": [{ "ok": false, "code": "missing" }] },
    { "name": "steps: a delete before the record exists", "steps": [{ "id": "#X1", "kind": "delete", "object": "task", "record": "#T09", "by": "noor", "at": "2026-10-30T09:00:00.000Z" }], "expect": [{ "ok": false, "code": "missing" }] },
    {
      "name": "steps: creating the same record twice, then updating another one",
      "steps": [
        { "id": "#X1", "kind": "create", "object": "task", "record": "#T09", "set": { "title": "A" }, "by": "noor", "at": "2026-10-30T09:00:00.000Z" },
        { "id": "#X2", "kind": "create", "object": "task", "record": "#T09", "set": { "title": "B" }, "by": "noor", "at": "2026-10-30T09:01:00.000Z" },
        { "id": "#X3", "kind": "update", "object": "task", "record": "#T01", "set": { "estimate": 1 }, "by": "noor", "at": "2026-10-30T09:02:00.000Z" }
      ],
      "expect": [
        { "ok": true, "record": { "id": "#T09", "values": { "title": "A", "status": null, "assignee": null, "due": null, "estimate": null, "budget": null, "urgent": false, "tags": null, "project": null, "depends": null, "files": null, "site": null, "contact": null, "phone": null, "notes": null }, "rev": 1, "created": { "by": "noor", "at": "2026-10-30T09:00:00.000Z" }, "modified": { "by": "noor", "at": "2026-10-30T09:00:00.000Z" }, "deleted": null } },
        { "ok": false, "code": "exists" },
        { "ok": false, "code": "wrong-record" }
      ]
    },
    { "name": "steps: a create without the required title", "steps": [{ "id": "#X1", "kind": "create", "object": "task", "record": "#T09", "set": { "status": "todo" }, "by": "noor", "at": "2026-10-30T09:00:00.000Z" }], "expect": [{ "ok": false, "code": "invalid" }] },
    { "name": "steps: a create with an empty required title", "steps": [{ "id": "#X1", "kind": "create", "object": "task", "record": "#T09", "set": { "title": null }, "by": "noor", "at": "2026-10-30T09:00:00.000Z" }], "expect": [{ "ok": false, "code": "invalid" }] },
    { "name": "steps: a value that is not in its canonical form", "steps": [{ "id": "#X1", "kind": "create", "object": "task", "record": "#T09", "set": { "title": "A", "tags": ["ui", "ui"] }, "by": "noor", "at": "2026-10-30T09:00:00.000Z" }], "expect": [{ "ok": false, "code": "invalid" }] },
    { "name": "steps: a text where a number belongs", "steps": [{ "id": "#X1", "kind": "create", "object": "task", "record": "#T09", "set": { "title": "A", "estimate": "3" }, "by": "noor", "at": "2026-10-30T09:00:00.000Z" }], "expect": [{ "ok": false, "code": "invalid" }] },
    { "name": "steps: a field the object does not have", "steps": [{ "id": "#X1", "kind": "create", "object": "task", "record": "#T09", "set": { "title": "A", "colour": "red" }, "by": "noor", "at": "2026-10-30T09:00:00.000Z" }], "expect": [{ "ok": false, "code": "invalid" }] },
    { "name": "steps: an update that changes nothing", "start": { "id": "#T09", "values": { "title": "A" }, "rev": 1, "created": { "by": "noor", "at": "2026-10-30T09:00:00.000Z" }, "modified": { "by": "noor", "at": "2026-10-30T09:00:00.000Z" }, "deleted": null }, "steps": [{ "id": "#X1", "kind": "update", "object": "task", "record": "#T09", "set": {}, "by": "noor", "at": "2026-10-30T09:01:00.000Z" }], "expect": [{ "ok": false, "code": "invalid" }] },
    { "name": "steps: an update that empties a required field", "start": { "id": "#T09", "values": { "title": "A" }, "rev": 1, "created": { "by": "noor", "at": "2026-10-30T09:00:00.000Z" }, "modified": { "by": "noor", "at": "2026-10-30T09:00:00.000Z" }, "deleted": null }, "steps": [{ "id": "#X1", "kind": "update", "object": "task", "record": "#T09", "set": { "title": null }, "by": "noor", "at": "2026-10-30T09:01:00.000Z" }], "expect": [{ "ok": false, "code": "invalid" }] },
    { "name": "steps: prev holding a field the update does not set", "start": { "id": "#T09", "values": { "title": "A" }, "rev": 1, "created": { "by": "noor", "at": "2026-10-30T09:00:00.000Z" }, "modified": { "by": "noor", "at": "2026-10-30T09:00:00.000Z" }, "deleted": null }, "steps": [{ "id": "#X1", "kind": "update", "object": "task", "record": "#T09", "set": { "estimate": 1 }, "prev": { "due": null }, "by": "noor", "at": "2026-10-30T09:01:00.000Z" }], "expect": [{ "ok": false, "code": "invalid" }] },
    { "name": "steps: a delete that carries values", "start": { "id": "#T09", "values": { "title": "A" }, "rev": 1, "created": { "by": "noor", "at": "2026-10-30T09:00:00.000Z" }, "modified": { "by": "noor", "at": "2026-10-30T09:00:00.000Z" }, "deleted": null }, "steps": [{ "id": "#X1", "kind": "delete", "object": "task", "record": "#T09", "set": { "title": "B" }, "by": "noor", "at": "2026-10-30T09:01:00.000Z" }], "expect": [{ "ok": false, "code": "invalid" }] },
    { "name": "steps: a day that does not exist in the timestamp", "steps": [{ "id": "#X1", "kind": "create", "object": "task", "record": "#T09", "set": { "title": "A" }, "by": "noor", "at": "2026-02-30T09:00:00.000Z" }], "expect": [{ "ok": false, "code": "invalid" }] },
    { "name": "steps: a time that does not exist in the timestamp", "steps": [{ "id": "#X1", "kind": "create", "object": "task", "record": "#T09", "set": { "title": "A" }, "by": "noor", "at": "2026-10-30T24:00:00.000Z" }], "expect": [{ "ok": false, "code": "invalid" }] },
    { "name": "steps: a timestamp without milliseconds", "steps": [{ "id": "#X1", "kind": "create", "object": "task", "record": "#T09", "set": { "title": "A" }, "by": "noor", "at": "2026-10-30T09:00:00Z" }], "expect": [{ "ok": false, "code": "invalid" }] },
    { "name": "steps: an operation id that is not a ULID", "steps": [{ "id": "op-1", "kind": "create", "object": "task", "record": "#T09", "set": { "title": "A" }, "by": "noor", "at": "2026-10-30T09:00:00.000Z" }], "expect": [{ "ok": false, "code": "invalid" }] },
    { "name": "steps: an operation for another object", "steps": [{ "id": "#X1", "kind": "create", "object": "note", "record": "#T09", "set": { "title": "A" }, "by": "noor", "at": "2026-10-30T09:00:00.000Z" }], "expect": [{ "ok": false, "code": "invalid" }] },
    { "name": "steps: an operation of an unknown kind", "steps": [{ "id": "#X1", "kind": "upsert", "object": "task", "record": "#T09", "set": { "title": "A" }, "by": "noor", "at": "2026-10-30T09:00:00.000Z" }], "expect": [{ "ok": false, "code": "invalid" }] },
    { "name": "steps: a stray key", "steps": [{ "id": "#X1", "kind": "create", "object": "task", "record": "#T09", "set": { "title": "A" }, "by": "noor", "at": "2026-10-30T09:00:00.000Z", "rev": 9 }], "expect": [{ "ok": false, "code": "invalid" }] },

    { "name": "buildCreate: raw values are put in their canonical form", "mode": "buildCreate", "values": { "title": "Hello", "urgent": true, "status": "todo", "estimate": 2, "budget": 1.005 }, "meta": { "id": "#X1", "record": "#T09", "by": "noor", "at": "2026-10-30T09:00:00.000Z" }, "expect": { "ok": true, "op": { "id": "#X1", "kind": "create", "object": "task", "record": "#T09", "set": { "title": "Hello", "urgent": true, "status": "todo", "estimate": 2, "budget": 1.01 }, "by": "noor", "at": "2026-10-30T09:00:00.000Z" } } },
    { "name": "buildCreate: the required title is missing", "mode": "buildCreate", "values": { "status": "todo" }, "meta": { "id": "#X1", "record": "#T09", "by": "noor", "at": "2026-10-30T09:00:00.000Z" }, "expect": { "ok": false, "errors": ["set.title:required"] } },
    { "name": "buildCreate: an empty title counts as missing, once", "mode": "buildCreate", "values": { "title": "" }, "meta": { "id": "#X1", "record": "#T09", "by": "noor", "at": "2026-10-30T09:00:00.000Z" }, "expect": { "ok": false, "errors": ["set.title:required"] } },
    { "name": "buildCreate: an unknown field", "mode": "buildCreate", "values": { "title": "x", "colour": "red" }, "meta": { "id": "#X1", "record": "#T09", "by": "noor", "at": "2026-10-30T09:00:00.000Z" }, "expect": { "ok": false, "errors": ["set.colour:unknown-field"] } },
    { "name": "buildCreate: a refused value", "mode": "buildCreate", "values": { "title": "x", "estimate": "3" }, "meta": { "id": "#X1", "record": "#T09", "by": "noor", "at": "2026-10-30T09:00:00.000Z" }, "expect": { "ok": false, "errors": ["set.estimate:type"] } },
    { "name": "buildUpdate: nothing really changes, so no operation", "mode": "buildUpdate", "record": "#T01", "changes": { "status": "doing", "estimate": 3, "tags": ["ui", "ui"], "budget": 120.004 }, "meta": { "id": "#X1", "by": "kaby", "at": "2026-10-30T09:00:00.000Z" }, "expect": { "ok": true, "op": null } },
    { "name": "buildUpdate: only what differs is kept, with what it replaced", "mode": "buildUpdate", "record": "#T01", "changes": { "status": "done", "due": null, "estimate": 3 }, "meta": { "id": "#X1", "by": "kaby", "at": "2026-10-30T09:00:00.000Z" }, "expect": { "ok": true, "op": { "id": "#X1", "kind": "update", "object": "task", "record": "#T01", "set": { "status": "done", "due": null }, "prev": { "status": "doing", "due": "2026-10-31" }, "by": "kaby", "at": "2026-10-30T09:00:00.000Z" } } },
    { "name": "buildUpdate: a field the record never held replaces null", "mode": "buildUpdate", "record": "#T01", "changes": { "depends": ["#T02"] }, "meta": { "id": "#X1", "by": "kaby", "at": "2026-10-30T09:00:00.000Z" }, "expect": { "ok": true, "op": { "id": "#X1", "kind": "update", "object": "task", "record": "#T01", "set": { "depends": ["#T02"] }, "prev": { "depends": null }, "by": "kaby", "at": "2026-10-30T09:00:00.000Z" } } },
    { "name": "buildUpdate: an unchecked box set to null is still unchecked", "mode": "buildUpdate", "record": "#T04", "changes": { "urgent": null }, "meta": { "id": "#X1", "by": "kaby", "at": "2026-10-30T09:00:00.000Z" }, "expect": { "ok": true, "op": null } },
    { "name": "buildUpdate: emptying the required title", "mode": "buildUpdate", "record": "#T01", "changes": { "title": "" }, "meta": { "id": "#X1", "by": "kaby", "at": "2026-10-30T09:00:00.000Z" }, "expect": { "ok": false, "errors": ["set.title:required"] } },
    { "name": "buildUpdate: a refused value", "mode": "buildUpdate", "record": "#T01", "changes": { "estimate": "x" }, "meta": { "id": "#X1", "by": "kaby", "at": "2026-10-30T09:00:00.000Z" }, "expect": { "ok": false, "errors": ["set.estimate:type"] } }
  ]
}
