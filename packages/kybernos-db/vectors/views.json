{
  "suite": "views",
  "doc": "Three modes. check: the « path:code » problems of a view for the task object. normalize: the canonical view with the defaults filled, or its problems. repair: the view made sound again after fields were removed (`keep` lists the fields that are left; all of them when absent).",
  "cases": [
    { "name": "check: a sound board", "mode": "check", "view": { "id": "task-board", "name": "Board", "kind": "board", "owner": "kaby", "fav": true, "by": "status", "state": { "flt": { "conj": "and", "items": [] }, "sorts": [], "hidden": [] } }, "expect": [] },
    { "name": "check: a sound calendar", "mode": "check", "view": { "id": "task-cal", "name": "Calendar", "kind": "calendar", "owner": "me", "fav": false, "date": "due", "state": { "flt": { "conj": "and", "items": [] }, "sorts": [], "hidden": [] } }, "expect": [] },
    { "name": "check: not an object", "mode": "check", "view": "board", "expect": [":shape"] },
    { "name": "check: a stray key", "mode": "check", "view": { "id": "v1", "name": "All", "kind": "table", "owner": "me", "fav": false, "color": "red", "state": { "flt": { "conj": "and", "items": [] }, "sorts": [], "hidden": [] } }, "expect": ["color:unknown-key"] },
    { "name": "check: an id with a space", "mode": "check", "view": { "id": "my view", "name": "All", "kind": "table", "owner": "me", "fav": false, "state": { "flt": { "conj": "and", "items": [] }, "sorts": [], "hidden": [] } }, "expect": ["id:id"] },
    { "name": "check: an empty name", "mode": "check", "view": { "id": "v1", "name": " ", "kind": "table", "owner": "me", "fav": false, "state": { "flt": { "conj": "and", "items": [] }, "sorts": [], "hidden": [] } }, "expect": ["name:name"] },
    { "name": "check: an unknown kind", "mode": "check", "view": { "id": "v1", "name": "All", "kind": "gantt", "owner": "me", "fav": false, "state": { "flt": { "conj": "and", "items": [] }, "sorts": [], "hidden": [] } }, "expect": ["kind:kind"] },
    { "name": "check: an unknown owner", "mode": "check", "view": { "id": "v1", "name": "All", "kind": "table", "owner": "bob", "fav": false, "state": { "flt": { "conj": "and", "items": [] }, "sorts": [], "hidden": [] } }, "expect": ["owner:owner"] },
    { "name": "check: fav is true or false", "mode": "check", "view": { "id": "v1", "name": "All", "kind": "table", "owner": "me", "fav": "yes", "state": { "flt": { "conj": "and", "items": [] }, "sorts": [], "hidden": [] } }, "expect": ["fav:type"] },
    { "name": "check: a board needs its columns", "mode": "check", "view": { "id": "v1", "name": "Board", "kind": "board", "owner": "me", "fav": false, "state": { "flt": { "conj": "and", "items": [] }, "sorts": [], "hidden": [] } }, "expect": ["by:by"] },
    { "name": "check: a board's columns come from a choice field", "mode": "check", "view": { "id": "v1", "name": "Board", "kind": "board", "owner": "me", "fav": false, "by": "due", "state": { "flt": { "conj": "and", "items": [] }, "sorts": [], "hidden": [] } }, "expect": ["by:by"] },
    { "name": "check: a table has no columns field", "mode": "check", "view": { "id": "v1", "name": "All", "kind": "table", "owner": "me", "fav": false, "by": "status", "state": { "flt": { "conj": "and", "items": [] }, "sorts": [], "hidden": [] } }, "expect": ["by:not-for-kind"] },
    { "name": "check: a calendar needs a date field", "mode": "check", "view": { "id": "v1", "name": "Calendar", "kind": "calendar", "owner": "me", "fav": false, "state": { "flt": { "conj": "and", "items": [] }, "sorts": [], "hidden": [] } }, "expect": ["date:date"] },
    { "name": "check: a view needs a state", "mode": "check", "view": { "id": "v1", "name": "All", "kind": "table", "owner": "me", "fav": false }, "expect": ["state:shape"] },
    { "name": "check: the title field is always shown", "mode": "check", "view": { "id": "v1", "name": "All", "kind": "table", "owner": "me", "fav": false, "state": { "flt": { "conj": "and", "items": [] }, "sorts": [], "hidden": ["title"] } }, "expect": ["state.hidden.0:title"] },
    { "name": "check: hiding an unknown field", "mode": "check", "view": { "id": "v1", "name": "All", "kind": "table", "owner": "me", "fav": false, "state": { "flt": { "conj": "and", "items": [] }, "sorts": [], "hidden": ["nope"] } }, "expect": ["state.hidden.0:unknown-field"] },
    { "name": "check: hiding a field twice", "mode": "check", "view": { "id": "v1", "name": "All", "kind": "table", "owner": "me", "fav": false, "state": { "flt": { "conj": "and", "items": [] }, "sorts": [], "hidden": ["notes", "notes"] } }, "expect": ["state.hidden:duplicate"] },
    { "name": "check: hidden is a list", "mode": "check", "view": { "id": "v1", "name": "All", "kind": "table", "owner": "me", "fav": false, "state": { "flt": { "conj": "and", "items": [] }, "sorts": [], "hidden": "notes" } }, "expect": ["state.hidden:shape"] },
    { "name": "check: a filter problem carries the path into the state", "mode": "check", "view": { "id": "v1", "name": "All", "kind": "table", "owner": "me", "fav": false, "state": { "flt": { "conj": "and", "items": [{ "k": "nope", "op": "empty" }] }, "sorts": [], "hidden": [] } }, "expect": ["state.flt.0:unknown-field"] },
    { "name": "check: a broken filter", "mode": "check", "view": { "id": "v1", "name": "All", "kind": "table", "owner": "me", "fav": false, "state": { "flt": null, "sorts": [], "hidden": [] } }, "expect": ["state.flt:shape"] },
    { "name": "check: a sort problem carries the path into the state", "mode": "check", "view": { "id": "v1", "name": "All", "kind": "table", "owner": "me", "fav": false, "state": { "flt": { "conj": "and", "items": [] }, "sorts": [{ "k": "files", "dir": "asc" }], "hidden": [] } }, "expect": ["state.sorts.0:not-sortable"] },

    { "name": "normalize: a minimal table gets its defaults", "mode": "normalize", "view": { "id": "v1", "name": "All tasks", "kind": "table" }, "expect": { "ok": true, "view": { "id": "v1", "name": "All tasks", "kind": "table", "owner": "me", "fav": false, "state": { "flt": { "conj": "and", "items": [] }, "sorts": [], "hidden": [] } } } },
    { "name": "normalize: a board takes the first choice field for its columns", "mode": "normalize", "view": { "id": "v2", "name": "Board", "kind": "board" }, "expect": { "ok": true, "view": { "id": "v2", "name": "Board", "kind": "board", "owner": "me", "fav": false, "by": "status", "state": { "flt": { "conj": "and", "items": [] }, "sorts": [], "hidden": [] } } } },
    { "name": "normalize: a calendar takes the first date field", "mode": "normalize", "view": { "id": "v3", "name": "Calendar", "kind": "calendar" }, "expect": { "ok": true, "view": { "id": "v3", "name": "Calendar", "kind": "calendar", "owner": "me", "fav": false, "date": "due", "state": { "flt": { "conj": "and", "items": [] }, "sorts": [], "hidden": [] } } } },
    { "name": "normalize: the name is trimmed and the given values are kept", "mode": "normalize", "view": { "id": "v4", "name": "  Mine  ", "kind": "table", "owner": "kaby", "fav": true, "state": { "flt": { "conj": "and", "items": [{ "k": "assignee", "op": "is", "v": "@me" }] }, "sorts": [{ "k": "due", "dir": "asc" }], "hidden": ["notes"] } }, "expect": { "ok": true, "view": { "id": "v4", "name": "Mine", "kind": "table", "owner": "kaby", "fav": true, "state": { "flt": { "conj": "and", "items": [{ "k": "assignee", "op": "is", "v": "@me" }] }, "sorts": [{ "k": "due", "dir": "asc" }], "hidden": ["notes"] } } } },
    { "name": "normalize: an object without a choice field has no board", "mode": "normalize", "object": "note", "view": { "id": "v5", "name": "Board", "kind": "board" }, "expect": { "ok": false, "errors": ["by:by"] } },
    { "name": "normalize: an unsound state is refused", "mode": "normalize", "view": { "id": "v6", "name": "All", "kind": "table", "state": { "hidden": ["title"] } }, "expect": { "ok": false, "errors": ["state.hidden.0:title"] } },
    { "name": "normalize: not an object", "mode": "normalize", "view": 5, "expect": { "ok": false, "errors": [":shape"] } },

    { "name": "repair: what points at a removed field is cut", "mode": "repair", "keep": ["title", "status", "assignee", "due", "estimate", "urgent", "tags", "project", "depends", "files", "site", "contact", "phone", "notes"], "view": { "id": "b1", "name": "Board", "kind": "board", "owner": "kaby", "fav": true, "by": "status", "state": { "flt": { "conj": "and", "items": [{ "k": "budget", "op": "gt", "v": 100 }, { "k": "status", "op": "is", "v": "todo" }] }, "sorts": [{ "k": "budget", "dir": "asc" }, { "k": "due", "dir": "asc" }], "hidden": ["budget", "notes"] } }, "expect": { "id": "b1", "name": "Board", "kind": "board", "owner": "kaby", "fav": true, "by": "status", "state": { "flt": { "conj": "and", "items": [{ "k": "status", "op": "is", "v": "todo" }] }, "sorts": [{ "k": "due", "dir": "asc" }], "hidden": ["notes"] } } },
    { "name": "repair: a board that lost its only choice field becomes a table", "mode": "repair", "keep": ["title", "due", "estimate"], "view": { "id": "b2", "name": "Board", "kind": "board", "owner": "me", "fav": false, "by": "status", "state": { "flt": { "conj": "and", "items": [{ "k": "status", "op": "is", "v": "todo" }] }, "sorts": [], "hidden": [] } }, "expect": { "id": "b2", "name": "Board", "kind": "table", "owner": "me", "fav": false, "state": { "flt": { "conj": "and", "items": [] }, "sorts": [], "hidden": [] } } },
    { "name": "repair: a calendar that lost its date field becomes a table", "mode": "repair", "keep": ["title", "status"], "view": { "id": "c1", "name": "Calendar", "kind": "calendar", "owner": "me", "fav": true, "date": "due", "state": { "flt": { "conj": "and", "items": [] }, "sorts": [{ "k": "due", "dir": "asc" }], "hidden": [] } }, "expect": { "id": "c1", "name": "Calendar", "kind": "table", "owner": "me", "fav": true, "state": { "flt": { "conj": "and", "items": [] }, "sorts": [], "hidden": [] } } },
    { "name": "repair: a board whose column field is no longer a choice takes another one", "mode": "repair", "view": { "id": "b3", "name": "Board", "kind": "board", "owner": "me", "fav": false, "by": "due", "state": { "flt": { "conj": "and", "items": [] }, "sorts": [], "hidden": [] } }, "expect": { "id": "b3", "name": "Board", "kind": "board", "owner": "me", "fav": false, "by": "status", "state": { "flt": { "conj": "and", "items": [] }, "sorts": [], "hidden": [] } } },
    { "name": "repair: the title is never hidden and a field is hidden once", "mode": "repair", "view": { "id": "t1", "name": "All", "kind": "table", "owner": "me", "fav": false, "state": { "flt": { "conj": "and", "items": [] }, "sorts": [], "hidden": ["title", "notes", "notes"] } }, "expect": { "id": "t1", "name": "All", "kind": "table", "owner": "me", "fav": false, "state": { "flt": { "conj": "and", "items": [] }, "sorts": [], "hidden": ["notes"] } } },
    { "name": "repair: a sound table is left as it is", "mode": "repair", "view": { "id": "t2", "name": "Mine", "kind": "table", "owner": "kaby", "fav": true, "state": { "flt": { "conj": "and", "items": [{ "k": "assignee", "op": "is", "v": "@me" }] }, "sorts": [{ "k": "due", "dir": "asc" }], "hidden": ["notes"] } }, "expect": { "id": "t2", "name": "Mine", "kind": "table", "owner": "kaby", "fav": true, "state": { "flt": { "conj": "and", "items": [{ "k": "assignee", "op": "is", "v": "@me" }] }, "sorts": [{ "k": "due", "dir": "asc" }], "hidden": ["notes"] } } },
    { "name": "repair: a missing fav becomes false", "mode": "repair", "view": { "id": "t3", "name": "All", "kind": "table", "owner": "me", "state": { "flt": { "conj": "and", "items": [] }, "sorts": [], "hidden": [] } }, "expect": { "id": "t3", "name": "All", "kind": "table", "owner": "me", "fav": false, "state": { "flt": { "conj": "and", "items": [] }, "sorts": [], "hidden": [] } } }
  ]
}
