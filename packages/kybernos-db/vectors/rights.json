{
  "suite": "rights",
  "doc": "can(actor, action, resource): { effect: allow | ask | deny, reason?, mask? }. Phase A: the owner may do everything; the owner's agent asks before it touches a protected field or the structure and can only raise a protection; anyone else is refused.",
  "cases": [
    { "name": "the owner edits a record", "actor": { "kind": "person", "role": "owner" }, "action": "record.update", "expect": { "effect": "allow" } },
    { "name": "the owner reads a normal field", "actor": { "kind": "person", "role": "owner" }, "action": "field.read", "resource": { "field": { "protection": "normal" } }, "expect": { "effect": "allow" } },
    { "name": "the owner reads a personal field, masked until revealed", "actor": { "kind": "person", "role": "owner" }, "action": "field.read", "resource": { "field": { "protection": "personal" } }, "expect": { "effect": "allow", "mask": true } },
    { "name": "the owner reads a secret field, masked", "actor": { "kind": "person", "role": "owner" }, "action": "field.read", "resource": { "field": { "protection": "secret" } }, "expect": { "effect": "allow", "mask": true } },
    { "name": "the owner writes a secret field without being asked", "actor": { "kind": "person", "role": "owner" }, "action": "field.write", "resource": { "field": { "protection": "secret" } }, "expect": { "effect": "allow" } },
    { "name": "the owner changes the structure", "actor": { "kind": "person", "role": "owner" }, "action": "schema.change", "expect": { "effect": "allow" } },
    { "name": "the owner puts a table or an app away", "actor": { "kind": "person", "role": "owner" }, "action": "schema.archive", "expect": { "effect": "allow" } },
    { "name": "the owner deletes a table or an app for good", "actor": { "kind": "person", "role": "owner" }, "action": "schema.delete", "expect": { "effect": "allow" } },
    { "name": "the owner lowers a protection", "actor": { "kind": "person", "role": "owner" }, "action": "field.protect", "resource": { "field": { "protection": "secret" }, "to": "normal" }, "expect": { "effect": "allow" } },

    { "name": "the agent reads records", "actor": { "kind": "agent", "role": "owner" }, "action": "record.read", "expect": { "effect": "allow" } },
    { "name": "the agent creates, updates and deletes records", "actor": { "kind": "agent", "role": "owner" }, "action": "record.delete", "expect": { "effect": "allow" } },
    { "name": "the agent edits a view", "actor": { "kind": "agent", "role": "owner" }, "action": "view.edit", "expect": { "effect": "allow" } },
    { "name": "the agent changes the structure only with the person's OK", "actor": { "kind": "agent", "role": "owner" }, "action": "schema.change", "expect": { "effect": "ask", "reason": "schema-change" } },
    { "name": "the agent puts a table or an app away only with the person's OK", "actor": { "kind": "agent", "role": "owner" }, "action": "schema.archive", "expect": { "effect": "ask", "reason": "archive" } },
    { "name": "the agent never deletes a table or an app for good", "actor": { "kind": "agent", "role": "owner" }, "action": "schema.delete", "expect": { "effect": "deny", "reason": "person-only" } },
    { "name": "the agent reads a normal field", "actor": { "kind": "agent", "role": "owner" }, "action": "field.read", "resource": { "field": { "protection": "normal" } }, "expect": { "effect": "allow" } },
    { "name": "the agent reads a field with no protection stated", "actor": { "kind": "agent", "role": "owner" }, "action": "field.read", "resource": { "field": {} }, "expect": { "effect": "allow" } },
    { "name": "the agent reads with no resource", "actor": { "kind": "agent", "role": "owner" }, "action": "field.read", "expect": { "effect": "allow" } },
    { "name": "the agent asks before reading a personal field", "actor": { "kind": "agent", "role": "owner" }, "action": "field.read", "resource": { "field": { "protection": "personal" } }, "expect": { "effect": "ask", "reason": "protected-field" } },
    { "name": "the agent asks before reading a secret field", "actor": { "kind": "agent", "role": "owner" }, "action": "field.read", "resource": { "field": { "protection": "secret" } }, "expect": { "effect": "ask", "reason": "protected-field" } },
    { "name": "the agent asks before writing a sensitive field", "actor": { "kind": "agent", "role": "owner" }, "action": "field.write", "resource": { "field": { "protection": "sensitive" } }, "expect": { "effect": "ask", "reason": "protected-field" } },
    { "name": "the agent raises a protection", "actor": { "kind": "agent", "role": "owner" }, "action": "field.protect", "resource": { "field": { "protection": "normal" }, "to": "personal" }, "expect": { "effect": "allow" } },
    { "name": "the agent keeps a protection as it is", "actor": { "kind": "agent", "role": "owner" }, "action": "field.protect", "resource": { "field": { "protection": "personal" }, "to": "personal" }, "expect": { "effect": "allow" } },
    { "name": "the agent never lowers a protection", "actor": { "kind": "agent", "role": "owner" }, "action": "field.protect", "resource": { "field": { "protection": "personal" }, "to": "normal" }, "expect": { "effect": "deny", "reason": "agent-cannot-lower" } },
    { "name": "the agent never lowers a secret to sensitive", "actor": { "kind": "agent", "role": "owner" }, "action": "field.protect", "resource": { "field": { "protection": "secret" }, "to": "sensitive" }, "expect": { "effect": "deny", "reason": "agent-cannot-lower" } },
    { "name": "the agent asks for no level: refused", "actor": { "kind": "agent", "role": "owner" }, "action": "field.protect", "resource": { "field": { "protection": "normal" } }, "expect": { "effect": "deny", "reason": "agent-cannot-lower" } },
    { "name": "the agent asks for a level that does not exist: refused", "actor": { "kind": "agent", "role": "owner" }, "action": "field.protect", "resource": { "field": { "protection": "normal" }, "to": "top" }, "expect": { "effect": "deny", "reason": "agent-cannot-lower" } },

    { "name": "a team member is refused until profiles exist", "actor": { "kind": "person", "role": "member" }, "action": "record.read", "expect": { "effect": "deny", "reason": "not-owner" } },
    { "name": "a team member cannot archive", "actor": { "kind": "person", "role": "member" }, "action": "schema.archive", "expect": { "effect": "deny", "reason": "not-owner" } },
    { "name": "no actor", "actor": null, "action": "record.read", "expect": { "effect": "deny", "reason": "not-owner" } },
    { "name": "an action that does not exist", "actor": { "kind": "person", "role": "owner" }, "action": "db.drop", "expect": { "effect": "deny", "reason": "unknown-action" } },
    { "name": "an actor of an unknown kind", "actor": { "kind": "bot", "role": "owner" }, "action": "record.read", "expect": { "effect": "deny", "reason": "unknown-actor" } },
    { "name": "a member reads a table they have a grant for", "actor": { "kind": "member", "role": "member", "profile": "#PROFILE-SHOP" }, "action": "record.read", "resource": {"object": "orders"}, "expect": { "effect": "allow" } },
    { "name": "a member adds a row to a table they may add to", "actor": { "kind": "member", "role": "member", "profile": "#PROFILE-SHOP" }, "action": "record.create", "resource": {"object": "orders"}, "expect": { "effect": "allow" } },
    { "name": "a member edits a row of a table they may edit", "actor": { "kind": "member", "role": "member", "profile": "#PROFILE-SHOP" }, "action": "record.update", "resource": {"object": "orders"}, "expect": { "effect": "allow" } },
    { "name": "a member never deletes an order", "actor": { "kind": "member", "role": "member", "profile": "#PROFILE-SHOP" }, "action": "record.delete", "resource": {"object": "orders"}, "expect": { "effect": "deny", "reason": "members-never-delete" } },
    { "name": "a member never deletes a contact, though they edit contacts", "actor": { "kind": "member", "role": "member", "profile": "#PROFILE-SHOP" }, "action": "record.delete", "resource": {"object": "contact"}, "expect": { "effect": "deny", "reason": "members-never-delete" } },
    { "name": "a member reads a table that is read-only for them", "actor": { "kind": "member", "role": "member", "profile": "#PROFILE-SHOP" }, "action": "record.read", "resource": {"object": "product"}, "expect": { "effect": "allow" } },
    { "name": "a member cannot add to a read-only table", "actor": { "kind": "member", "role": "member", "profile": "#PROFILE-SHOP" }, "action": "record.create", "resource": {"object": "product"}, "expect": { "effect": "deny", "reason": "no-access" } },
    { "name": "a member may edit a row of a read-only table when one field is writable", "actor": { "kind": "member", "role": "member", "profile": "#PROFILE-SHOP" }, "action": "record.update", "resource": {"object": "product"}, "expect": { "effect": "allow" } },
    { "name": "the writable field of a read-only table is writable", "actor": { "kind": "member", "role": "member", "profile": "#PROFILE-SHOP" }, "action": "field.write", "resource": {"object": "product", "field": {"key": "stock", "protection": "normal"}}, "expect": { "effect": "allow" } },
    { "name": "the other fields of a read-only table stay read-only", "actor": { "kind": "member", "role": "member", "profile": "#PROFILE-SHOP" }, "action": "field.write", "resource": {"object": "product", "field": {"key": "price", "protection": "normal"}}, "expect": { "effect": "deny", "reason": "read-only-field" } },
    { "name": "a member reads a field of a read-only table", "actor": { "kind": "member", "role": "member", "profile": "#PROFILE-SHOP" }, "action": "field.read", "resource": {"object": "product", "field": {"key": "price", "protection": "normal"}}, "expect": { "effect": "allow" } },
    { "name": "a member reads a normal field of a table they edit", "actor": { "kind": "member", "role": "member", "profile": "#PROFILE-SHOP" }, "action": "field.read", "resource": {"object": "orders", "field": {"key": "value", "protection": "normal"}}, "expect": { "effect": "allow" } },
    { "name": "a member writes a normal field of a table they edit", "actor": { "kind": "member", "role": "member", "profile": "#PROFILE-SHOP" }, "action": "field.write", "resource": {"object": "orders", "field": {"key": "title", "protection": "normal"}}, "expect": { "effect": "allow" } },
    { "name": "a personal field the profile names is shown in clear, not masked", "actor": { "kind": "member", "role": "member", "profile": "#PROFILE-SHOP" }, "action": "field.read", "resource": {"object": "contact", "field": {"key": "email", "protection": "personal"}}, "expect": { "effect": "allow" } },
    { "name": "a personal field named read-only cannot be written", "actor": { "kind": "member", "role": "member", "profile": "#PROFILE-SHOP" }, "action": "field.write", "resource": {"object": "contact", "field": {"key": "email", "protection": "personal"}}, "expect": { "effect": "deny", "reason": "read-only-field" } },
    { "name": "a personal field the profile does not name is hidden", "actor": { "kind": "member", "role": "member", "profile": "#PROFILE-SHOP" }, "action": "field.read", "resource": {"object": "contact", "field": {"key": "phone", "protection": "personal"}}, "expect": { "effect": "deny", "reason": "hidden-field" } },
    { "name": "a personal field the profile does not name cannot be written", "actor": { "kind": "member", "role": "member", "profile": "#PROFILE-SHOP" }, "action": "field.write", "resource": {"object": "contact", "field": {"key": "phone", "protection": "personal"}}, "expect": { "effect": "deny", "reason": "hidden-field" } },
    { "name": "a sensitive field is hidden even when the profile names it", "actor": { "kind": "member", "role": "member", "profile": "#PROFILE-SHOP" }, "action": "field.read", "resource": {"object": "contact", "field": {"key": "iban", "protection": "sensitive"}}, "expect": { "effect": "deny", "reason": "hidden-field" } },
    { "name": "a secret field is hidden even when the profile names it writable", "actor": { "kind": "member", "role": "member", "profile": "#PROFILE-SHOP" }, "action": "field.write", "resource": {"object": "contact", "field": {"key": "token", "protection": "secret"}}, "expect": { "effect": "deny", "reason": "hidden-field" } },
    { "name": "a table without a grant is closed", "actor": { "kind": "member", "role": "member", "profile": "#PROFILE-SHOP" }, "action": "record.read", "resource": {"object": "invoice"}, "expect": { "effect": "deny", "reason": "no-access" } },
    { "name": "a field of a table without a grant is closed with its table", "actor": { "kind": "member", "role": "member", "profile": "#PROFILE-SHOP" }, "action": "field.read", "resource": {"object": "invoice", "field": {"key": "total", "protection": "normal"}}, "expect": { "effect": "deny", "reason": "no-access" } },
    { "name": "a member cannot change the structure", "actor": { "kind": "member", "role": "member", "profile": "#PROFILE-SHOP" }, "action": "schema.change", "resource": {"object": "orders"}, "expect": { "effect": "deny", "reason": "owner-only" } },
    { "name": "a member cannot put a table away", "actor": { "kind": "member", "role": "member", "profile": "#PROFILE-SHOP" }, "action": "schema.archive", "resource": {"object": "orders"}, "expect": { "effect": "deny", "reason": "owner-only" } },
    { "name": "a member cannot delete a table for good", "actor": { "kind": "member", "role": "member", "profile": "#PROFILE-SHOP" }, "action": "schema.delete", "resource": {"object": "orders"}, "expect": { "effect": "deny", "reason": "owner-only" } },
    { "name": "a member cannot edit a view", "actor": { "kind": "member", "role": "member", "profile": "#PROFILE-SHOP" }, "action": "view.edit", "resource": {"object": "orders"}, "expect": { "effect": "deny", "reason": "owner-only" } },
    { "name": "a member cannot change a protection", "actor": { "kind": "member", "role": "member", "profile": "#PROFILE-SHOP" }, "action": "field.protect", "resource": {"object": "orders", "field": {"key": "value", "protection": "normal"}}, "expect": { "effect": "deny", "reason": "owner-only" } },
    { "name": "a member without a profile is refused", "actor": { "kind": "member", "role": "member" }, "action": "record.read", "resource": {"object": "orders"}, "expect": { "effect": "deny", "reason": "no-profile" } },
    { "name": "a member asking for something that does not exist is refused", "actor": { "kind": "member", "role": "member", "profile": "#PROFILE-SHOP" }, "action": "db.drop", "resource": {"object": "orders"}, "expect": { "effect": "deny", "reason": "unknown-action" } },
    { "name": "a field answer needs the field", "actor": { "kind": "member", "role": "member", "profile": "#PROFILE-SHOP" }, "action": "field.read", "resource": {"object": "orders"}, "expect": { "effect": "deny", "reason": "no-field" } },
    { "name": "a profile that can only add lets a member add", "actor": { "kind": "member", "role": "intake", "profile": "#PROFILE-INTAKE" }, "action": "record.create", "resource": {"object": "orders"}, "expect": { "effect": "allow" } },
    { "name": "a profile that can only add does not let a member read", "actor": { "kind": "member", "role": "intake", "profile": "#PROFILE-INTAKE" }, "action": "record.read", "resource": {"object": "orders"}, "expect": { "effect": "deny", "reason": "no-access" } },
    { "name": "a profile that can only add does not let a member edit", "actor": { "kind": "member", "role": "intake", "profile": "#PROFILE-INTAKE" }, "action": "record.update", "resource": {"object": "orders"}, "expect": { "effect": "deny", "reason": "no-access" } },
    { "name": "a profile that can only add still writes a normal field of what it adds", "actor": { "kind": "member", "role": "intake", "profile": "#PROFILE-INTAKE" }, "action": "field.write", "resource": {"object": "orders", "field": {"key": "title", "protection": "normal"}}, "expect": { "effect": "allow" } },
    { "name": "a person whose role is member is still refused: only the owner is a person here", "actor": { "kind": "person", "role": "member" }, "action": "record.read", "resource": {"object": "orders"}, "expect": { "effect": "deny", "reason": "not-owner" } }
  ]
}
