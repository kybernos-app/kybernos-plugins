{
  "name": "@local/dsh-db-viewer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Viewer for the SQLite databases of Agent Teams in the DSH right sidebar — Diagram (drawdb style), Charts, Data and SQL views.",
  "license": "Apache-2.0",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client",
    "cordis.patch.yml"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "node --check client/client.js",
    "test": "node test/test-host.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    }
  }
}
