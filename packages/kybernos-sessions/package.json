{
  "name": "@local/kybernos-sessions",
  "version": "1.0.0",
  "description": "Session status per folder (recent sessions, git state) and kyber memory status (lessons, ledger runs, members).",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
