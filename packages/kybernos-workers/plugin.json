{
  "contract": 1,
  "id": "kybernos/workers",
  "kind": "code",
  "version": "0.1.0",
  "name": {
    "en": "Workers",
    "fr": "Workers"
  },
  "description": {
    "en": "Installs, checks and exposes to the main agent Claude Code, Codex, Gemini, OpenCode, Qwen, Hermes and ZCode.",
    "fr": "Installe, vérifie et expose à l’agent principal Claude Code, Codex, Gemini, OpenCode, Qwen, Hermes et ZCode."
  },
  "icon": "wrench",
  "family": "connect",
  "author": {
    "id": "kybernos",
    "name": "Kybernos"
  },
  "license": "Apache-2.0",
  "pricing": "free",
  "package": "@local/kybernos-workers",
  "entry": {
    "host": "index.js",
    "client": "client.js"
  },
  "requires": {
    "kybernos": ">=0.1.0"
  },
  "permissions": [
    "ui.slot:settings.section",
    "host.routes:/kybernos-workers:write",
    "fs.write:dsh-home",
    "fs.write:home",
    "net:claude.ai",
    "net:hermes-agent.nousresearch.com",
    "net:opencode.ai",
    "net:registry.npmjs.org",
    "exec",
    "secrets.own",
    "secrets.read"
  ],
  "claims": {
    "routePrefixes": [
      "/kybernos-workers"
    ]
  },
  "help": "help.json",
  "suite": {
    "default": "on"
  }
}
