{
  "contract": 1,
  "id": "kybernos/composio",
  "kind": "code",
  "version": "1.0.0",
  "name": {
    "en": "Connectors",
    "fr": "Connecteurs"
  },
  "description": {
    "en": "Hundreds of connectors as ready-made cards for the agent.",
    "fr": "Des centaines de connecteurs en cartes prêtes pour l’agent."
  },
  "icon": "plug",
  "family": "connect",
  "author": {
    "id": "kybernos",
    "name": "Kybernos"
  },
  "license": "Apache-2.0",
  "pricing": "free",
  "package": "@local/kybernos-composio",
  "entry": {
    "host": "index.js",
    "client": "client.js"
  },
  "requires": {
    "kybernos": ">=0.1.0"
  },
  "permissions": [
    "ui.slot:plugins.bundle.config",
    "ui.slot:settings.section",
    "ui.dom",
    "host.routes:/kybernos/composio:write",
    "fs.write:dsh-home",
    "net:connect.composio.dev",
    "net:localhost",
    "exec",
    "secrets.own",
    "secrets.read",
    "agent.tools"
  ],
  "claims": {
    "routePrefixes": [
      "/kybernos/composio"
    ]
  },
  "help": "help.json",
  "suite": {
    "default": "off"
  }
}
