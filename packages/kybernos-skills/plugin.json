{
  "contract": 1,
  "id": "kybernos/skills",
  "kind": "code",
  "version": "1.0.0",
  "name": {
    "en": "Skills",
    "fr": "Compétences"
  },
  "description": {
    "en": "Local skills, created by chat.",
    "fr": "Compétences locales, créées par chat."
  },
  "icon": "bolt",
  "family": "base",
  "author": {
    "id": "kybernos",
    "name": "Kybernos"
  },
  "license": "Apache-2.0",
  "pricing": "free",
  "package": "@local/kybernos-skills",
  "entry": {
    "host": "index.js",
    "client": "client.js"
  },
  "requires": {
    "kybernos": ">=0.1.0"
  },
  "permissions": [
    "ui.slot:main.kybernos-skills",
    "ui.slot:settings.section",
    "ui.slot:conversation.chat.turnTail",
    "host.routes:/kybernos-skills:write",
    "fs.read:workspace",
    "fs.write:dsh-home",
    "fs.write:home",
    "net:api.github.com",
    "net:codeload.github.com",
    "net:raw.githubusercontent.com",
    "net:skills.kybernos.app",
    "exec:explorer",
    "exec:notepad",
    "exec:open",
    "exec:tar",
    "exec:xdg-open",
    "agent.prompt",
    "agent.tools"
  ],
  "claims": {
    "routePrefixes": [
      "/kybernos-skills"
    ]
  },
  "help": "help.json",
  "suite": {
    "core": true,
    "default": "on"
  }
}
