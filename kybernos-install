#!/bin/sh
# ── Kybernos: installation ──────────────────────────────────────────────────
#
# Run it FROM the folder where you extracted the archive:
#
#   ./kybernos-install              # everything: checks, puts DSH in place if it is missing, grafts the plugin
#   ./kybernos-install --dry        # shows what would be done, touches NOTHING
#   ./kybernos-install --restart --force   # also restarts the DSH that is running, so the plugin's host code loads
#   ./kybernos-install --autostart         # also starts Kybernos by itself at login (asked when run in a terminal; --no-autostart: never)
#
# What the robot does, in this order: it checks the fingerprints of the archive, looks whether DSH is
# there (scenario A) or not (scenario B), takes a safety photo of your profile, writes, checks that DSH
# restarts, and if the start fails it PUTS THE PHOTO BACK. Nothing is done silently.
set -e
ici=$(cd "$(dirname "$0")" && pwd)

if ! command -v node >/dev/null 2>&1; then
  echo "Node.js is missing. Kybernos runs on Node:"
  echo "  https://nodejs.org/en/download            (or: brew install node)"
  exit 1
fi

# The minimum Node depends on the engine being installed (DSH 0.2.2 needs 24.9 or later, the older lines declare none), and the
# engine is not chosen yet: the robot reads the floor from dsh-compat.json (`dsh.node`) and refuses with a plain message.
# Here we only test what the robot itself needs (ES modules) and DISPLAY the version.
version_noeud=$(node --version 2>/dev/null || echo '?')
if ! node --input-type=module -e "await import('node:child_process')" >/dev/null 2>&1; then
  echo "Node $version_noeud cannot run the robot (ES modules unavailable)."
  echo "Install a recent version: https://nodejs.org/en/download"
  exit 1
fi
echo "Node $version_noeud"

# `--source` is added AFTER your arguments: if you pass one, yours wins (the robot takes the first
# occurrence).
exec node "$ici/scripts/dsh-lifecycle.mjs" bootstrap "$@" --source "$ici"
