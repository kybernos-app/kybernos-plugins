+/**
+ * Failures that justify retrying the summary on another route: the failed
+ * attempt produced no durable checkpoint, so a different provider can still
+ * write one. Deliberately excludes AUTH, INVALID_* and MAX_TOKENS: those fail
+ * identically everywhere, or mean a truncated but real summary.
+ */
+const SUMMARY_FALLBACK_CODES: ReadonlySet<string> = new Set([
+  ACCOUNT_QUOTA_EXCEEDED_CODE,
+  QUOTA_EXCEEDED_CODE,
+  'RATE_LIMIT',
+  'SERVER',
+  'TIMEOUT',
+  'TRANSPORT',
+  'STREAM_CLOSED',
+  'EMPTY_RESPONSE',
+  'MALFORMED_RESPONSE',
+  'CONTEXT_WINDOW_EXCEEDED',
+  'HTTP_413',
+  'HTTP_429',
+  'HTTP_500',
+  'HTTP_502',
+  'HTTP_503',
+  'HTTP_504',
+])
+
+/** True when another route could plausibly summarize the same conversation. */
+function isRetryableSummaryFailure(error: unknown): boolean {
+  const code = (error as { code?: unknown } | null)?.code
+  return typeof code === 'string' && SUMMARY_FALLBACK_CODES.has(code)
+}
+
+/**
+ * Ordered summary routes for one condensation: an explicit operator pin first,
+ * then the route that last answered (its prefix is warm), then the latest
+ * routed header, then the agent options. Duplicates collapse, so a fallback
+ * never retries the route that just failed.
+ * @param pinned - the configured summary target, when one is set.
+ * @param agent - supplies the latest header and the live fallback options.
+ * @param answered - route recorded on the latest assistant message.
+ * @returns the candidate routes, best first; empty when none is known.
+ */
+function summaryCandidates(
+  pinned: SummaryRoute | undefined,
+  agent: Agent,
+  answered: AnsweredRoute,
+): SummaryRoute[] {
+  const candidates: SummaryRoute[] = []
+  const seen = new Set<string>()
+  const offered = [
+    pinned,
+    completeRoute(answered ?? undefined),
+    routedTarget(agent.session),
+    completeRoute(agent.options),
+  ]
+  for (const route of offered) {
+    if (route === undefined) continue
+    const key = `${route.provider}/${route.model}`
+    if (seen.has(key)) continue
+    seen.add(key)
+    candidates.push(route)
+  }
+  return candidates
 }
 
