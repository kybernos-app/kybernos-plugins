# Copy to mobile/.env (git-ignored) and fill in. Never commit the real file.
# Use a throwaway Anthropic key with a low spend limit: a test build can carry it to a device cloud for one run, and you revoke it afterwards.
ANTHROPIC_API_KEY=
BROWSERSTACK_USERNAME=
BROWSERSTACK_ACCESS_KEY=
# Hard cap on the minutes one device run may use (the runners stop at 9.5 minutes anyway).
BROWSERSTACK_BUDGET_MINUTES=10
