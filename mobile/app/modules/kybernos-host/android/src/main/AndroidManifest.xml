<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
  <application>
    <!-- Optional (a switch in the app's settings, off by default): keeps the engine's process alive and visible while the app is in the background, so scheduled automations can run. -->
    <service android:name="expo.modules.kybernoshost.KeepAliveService" android:exported="false" android:foregroundServiceType="specialUse">
      <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE" android:value="On-device automation engine: runs the user's scheduled automations while the app is in the background, only when the user switched it on" />
    </service>
  </application>
</manifest>
