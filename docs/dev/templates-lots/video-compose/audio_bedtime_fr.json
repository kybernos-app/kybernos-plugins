      "text": "VOIX IA · HISTOIRE DU SOIR",
      "style": "pill",
      "y": 0.08,
      "anim": "fade"
    },
    {
      "at": 0.9,
      "to": 6.3,
      "text": "Il était une fois, au bord d'un lac tranquille,\\Nun petit renard qui avait peur du noir.",
      "style": "caption",
      "y": 0.86,
      "anim": "fade"
    },
    {
      "at": 6.6,
      "to": 11.7,
      "text": "Chaque soir, la lune lui souriait,\\Net chaque soir, il osait faire un pas de plus.",
      "style": "caption",
      "y": 0.86,
      "anim": "fade"
    },
    {
      "at": 12.1,
      "to": 15.1,
      "text": "Alors, ce soir-là, il ferma les yeux,",
      "style": "caption",
      "y": 0.86,
      "anim": "fade"
    },
    {
      "at": 15.2,
      "to": 19.2,
      "text": "respira doucement et suivit la lumière\\Njusqu'à sa maison.",
      "style": "caption",
      "y": 0.86,
      "anim": "fade"
    }
